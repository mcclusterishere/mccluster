# Postfix: is this a real mailbox?
#
# Returning nothing means Postfix REJECTS at RCPT time rather than
# accepting and bouncing later. That matters: a server that accepts
# everything and bounces afterwards is a backscatter source and gets
# blocklisted for being one.
hosts = REPLACE_DB_HOST
dbname = postgres
user = mailserver
password = REPLACE_DB_PASSWORD
query = SELECT maildir FROM public.mail_v_users WHERE email='%s'
