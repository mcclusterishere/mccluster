# Runtime
NODE_ENV=production
PORT=8080
APP_ORIGIN=https://matthew.mccluster.org
PLATFORM_ORIGIN=https://api.mccluster.org
ADMIN_TOKEN=replace-with-a-long-random-secret
SUBMISSION_SALT=replace-with-another-long-random-secret
ALLOWED_ORIGINS=https://matthew.mccluster.org

# Railway PostgreSQL
DATABASE_URL=postgresql://user:password@host:5432/railway

# Cloudflare R2 - permanent asset vault
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=mccluster-assets
R2_PUBLIC_BASE_URL=https://assets.mccluster.org

# NameSilo - domain reseller backend
NAMESILO_API_KEY=
NAMESILO_PAYMENT_ID=
NAMESILO_RESELLER_MARKUP_CENTS=1800
ALLOW_DOMAIN_PURCHASES=false

# Stripe - platform + client payment rails
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PLATFORM_COUNTRY=US
STRIPE_RETURN_URL=https://matthew.mccluster.org/account.html?stripe=return
STRIPE_REFRESH_URL=https://matthew.mccluster.org/account.html?stripe=refresh
ALLOW_LIVE_REVENUE_SHARE=false

# Gemini - business interview + structured site brief
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Runpod - GPU / Forge jobs
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
RUNPOD_SYNC=false
RUNPOD_RESULT_TIMEOUT_MS=900000

# Optional dedicated endpoints as Forge grows
RUNPOD_3D_ENDPOINT_ID=
RUNPOD_SPLAT_ENDPOINT_ID=
RUNPOD_VIDEO_ENDPOINT_ID=

# Feature gates
ENABLE_DOMAIN_SEARCH=true
ENABLE_SITE_INTERVIEW=true
ENABLE_DIRECT_UPLOADS=true
ENABLE_GPU_JOBS=true
ENABLE_PUBLIC_FORMS=true
