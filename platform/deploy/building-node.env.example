# Copy to /etc/here/building-node.env with mode 0600
NODE_ENV=production
BUILDING_NODE_PORT=8100
LOCAL_DATABASE_URL=postgresql://here:replace-me@127.0.0.1:5432/here_building
NODE_CODE=bldg-01-primary
BUILDING_CODE=bldg-01
NODE_KEY_ID=bldg-01-primary-v1
NODE_SHARED_SECRET=replace-with-at-least-32-random-characters
NODE_ACTIVE=true
CONTROL_PLANE_URL=https://control.private.mccluster.org
PRIVATE_ADDRESS=100.64.0.10
SOFTWARE_VERSION=0.1.0
LOCAL_ADMIN_TOKEN=replace-with-a-different-long-random-token
SYNC_INTERVAL_MS=5000
COMMAND_POLL_INTERVAL_MS=5000
HEARTBEAT_INTERVAL_MS=30000
