[Unit]
Description=HERE building node
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=simple
User=here
Group=here
WorkingDirectory=/opt/here/platform
EnvironmentFile=/etc/here/building-node.env
ExecStart=/usr/bin/node src/building-node.mjs
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/here
UMask=0077

[Install]
WantedBy=multi-user.target
