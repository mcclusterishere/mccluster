{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://matthew.mccluster.org/docs/spatial/capture-manifest.v1.schema.json",
 "title": "CaptureManifestV1",
 "description": "One camera session's spatial capture manifest. Structure only: the cross-field rules (consent gates keyframes, depth provenance, intrinsics vs stored image, rigid poses, city-cell public pins, no composited frames as reconstruction input) are enforced by packages/spatial-capture/validate.mjs. Contract: docs/spatial/CAPTURE-MANIFEST.md.",
 "type": "object",
 "required": [
  "schema",
  "capture_id",
  "created_at",
  "session",
  "timing",
  "cameras",
  "outputs"
 ],
 "properties": {
  "schema": {
   "const": "mccluster.spatial.capture-manifest.v1"
  },
  "capture_id": {
   "type": "string",
   "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
  },
  "created_at": {
   "type": "string",
   "format": "date-time"
  },
  "session": {
   "type": "object",
   "required": [
    "mission",
    "device",
    "consent",
    "retention"
   ],
   "properties": {
    "mission": {
     "type": "object",
     "properties": {
      "assignment_id": {
       "type": "string",
       "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
      },
      "live_session_id": {
       "type": "string",
       "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
      },
      "mission_id": {
       "type": [
        "string",
        "null"
       ]
      },
      "bounty_id": {
       "type": [
        "string",
        "null"
       ]
      }
     },
     "anyOf": [
      {
       "required": [
        "assignment_id"
       ]
      },
      {
       "required": [
        "live_session_id"
       ]
      }
     ]
    },
    "device": {
     "type": "object",
     "required": [
      "platform",
      "client",
      "capabilities"
     ],
     "properties": {
      "platform": {
       "enum": [
        "ios",
        "android",
        "web"
       ]
      },
      "client": {
       "enum": [
        "native-arkit",
        "native-arcore",
        "native-arcore-geospatial-ios",
        "web-getusermedia"
       ]
      },
      "model_class": {
       "type": "string"
      },
      "os_version": {
       "type": "string"
      },
      "app_version": {
       "type": "string"
      },
      "capabilities": {
       "type": "object",
       "required": [
        "world_tracking",
        "scene_depth_lidar",
        "depth_sensor",
        "imu",
        "geospatial"
       ],
       "additionalProperties": {
        "type": "boolean"
       }
      }
     }
    },
    "consent": {
     "type": "object",
     "required": [
      "live_version",
      "spatial_capture_granted",
      "allowed_uses",
      "model_training"
     ],
     "properties": {
      "live_version": {
       "type": "string"
      },
      "spatial_capture_granted": {
       "type": "boolean"
      },
      "spatial_capture_version": {
       "type": "string"
      },
      "spatial_granted_at": {
       "type": "string",
       "format": "date-time"
      },
      "allowed_uses": {
       "type": "array",
       "items": {
        "enum": [
         "live_mission_proof",
         "reconstruction",
         "localization_map",
         "replay",
         "public_composition"
        ]
       }
      },
      "model_training": {
       "type": "boolean"
      }
     }
    },
    "retention": {
     "type": "object",
     "required": [
      "original_days",
      "keyframes_days",
      "on_delete"
     ],
     "properties": {
      "original_days": {
       "type": "integer",
       "minimum": 1
      },
      "keyframes_days": {
       "type": "integer",
       "minimum": 1
      },
      "on_delete": {
       "enum": [
        "retire_derivatives",
        "rebuild_derivatives"
       ]
      }
     }
    }
   }
  },
  "timing": {
   "type": "object",
   "required": [
    "clock",
    "monotonic_epoch_utc",
    "sync_uncertainty_ms"
   ],
   "properties": {
    "clock": {
     "const": "monotonic"
    },
    "monotonic_epoch_utc": {
     "type": "string",
     "format": "date-time"
    },
    "sync_uncertainty_ms": {
     "type": "number",
     "minimum": 0
    },
    "video_pts": {
     "type": "object",
     "properties": {
      "timescale": {
       "type": "integer"
      },
      "offset_s": {
       "type": "number"
      }
     }
    }
   }
  },
  "cameras": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "camera_id",
     "image",
     "intrinsics",
     "digital_zoom",
     "stabilization"
    ],
    "properties": {
     "camera_id": {
      "type": "string"
     },
     "lens": {
      "type": "string"
     },
     "image": {
      "type": "object",
      "required": [
       "width",
       "height"
      ],
      "properties": {
       "width": {
        "type": "integer",
        "minimum": 1
       },
       "height": {
        "type": "integer",
        "minimum": 1
       }
      }
     },
     "intrinsics": {
      "type": "object",
      "required": [
       "fx",
       "fy",
       "cx",
       "cy",
       "calibration_source",
       "distortion"
      ],
      "properties": {
       "fx": {
        "type": "number",
        "exclusiveMinimum": 0
       },
       "fy": {
        "type": "number",
        "exclusiveMinimum": 0
       },
       "cx": {
        "type": "number"
       },
       "cy": {
        "type": "number"
       },
       "calibration_source": {
        "enum": [
         "device_reported",
         "calibrated",
         "estimated"
        ]
       },
       "distortion": {
        "type": "object",
        "required": [
         "model"
        ],
        "properties": {
         "model": {
          "type": "string"
         },
         "coeffs": {
          "type": "array",
          "items": {
           "type": "number"
          }
         }
        }
       }
      }
     },
     "crop_rotation": {
      "type": "object"
     },
     "digital_zoom": {
      "type": "number",
      "minimum": 1
     },
     "stabilization": {
      "enum": [
       "off",
       "on",
       "unknown"
      ]
     }
    }
   }
  },
  "outputs": {
   "type": "object",
   "required": [
    "private_original",
    "spatial_keyframes",
    "public_composition"
   ],
   "properties": {
    "private_original": {
     "type": "object",
     "required": [
      "role",
      "visibility",
      "source",
      "recording_ref"
     ],
     "properties": {
      "role": {
       "const": "private_original"
      },
      "visibility": {
       "const": "private"
      },
      "source": {
       "const": "camera_pre_composite"
      },
      "recording_ref": {
       "type": "object",
       "required": [
        "kind"
       ],
       "properties": {
        "kind": {
         "enum": [
          "live_mission_chunks",
          "native_file"
         ]
        }
       }
      }
     }
    },
    "spatial_keyframes": {
     "type": "object",
     "required": [
      "role",
      "visibility",
      "source",
      "authorized",
      "frames"
     ],
     "properties": {
      "role": {
       "const": "spatial_keyframes"
      },
      "visibility": {
       "const": "private"
      },
      "source": {
       "const": "camera_pre_composite"
      },
      "authorized": {
       "type": "boolean"
      },
      "selection": {
       "type": "object"
      },
      "frames": {
       "type": "array",
       "items": {
        "$ref": "#/$defs/keyframe"
       }
      }
     }
    },
    "public_composition": {
     "type": "object",
     "required": [
      "role",
      "source",
      "use_for_reconstruction",
      "layers",
      "publishing"
     ],
     "properties": {
      "role": {
       "const": "public_composition"
      },
      "source": {
       "const": "composited"
      },
      "use_for_reconstruction": {
       "const": false
      },
      "layers": {
       "type": "array",
       "items": {
        "enum": [
         "fictional_facades",
         "npcs",
         "mission_props",
         "hud",
         "weather_graphics",
         "captions"
        ]
       }
      },
      "public_pin": {
       "oneOf": [
        {
         "type": "null"
        },
        {
         "type": "object",
         "required": [
          "precision",
          "city",
          "cell_lat",
          "cell_lng"
         ],
         "properties": {
          "precision": {
           "const": "city_cell"
          },
          "city": {
           "type": "string"
          },
          "cell_lat": {
           "type": "number",
           "multipleOf": 0.1
          },
          "cell_lng": {
           "type": "number",
           "multipleOf": 0.1
          }
         }
        }
       ]
      },
      "publishing": {
       "type": "object",
       "required": [
        "version"
       ]
      }
     }
    },
    "replay_recipe": {
     "oneOf": [
      {
       "type": "null"
      },
      {
       "type": "object",
       "required": [
        "label"
       ],
       "properties": {
        "label": {
         "enum": [
          "faithful_replay",
          "reenactment",
          "fiction"
         ]
        },
        "block_revision": {
         "type": [
          "string",
          "null"
         ]
        },
        "asset_revision": {
         "type": [
          "string",
          "null"
         ]
        },
        "camera_path_ref": {
         "type": [
          "string",
          "null"
         ]
        },
        "lighting_time": {
         "type": [
          "string",
          "null"
         ]
        },
        "npc_ids": {
         "type": "array",
         "items": {
          "type": "string"
         }
        },
        "mission_state_ref": {
         "type": [
          "string",
          "null"
         ]
        },
        "weather": {
         "type": [
          "object",
          "null"
         ],
         "properties": {
          "region": {
           "type": "string"
          },
          "generated_at": {
           "type": "string",
           "format": "date-time"
          }
         }
        },
        "generated_additions": {
         "type": "array",
         "items": {
          "type": "string"
         }
        },
        "proof": {
         "const": false
        }
       }
      }
     ]
    }
   }
  },
  "integrity": {
   "type": "object"
  }
 },
 "$defs": {
  "keyframe": {
   "type": "object",
   "required": [
    "frame_id",
    "t_mono_s",
    "camera_id",
    "image",
    "pose",
    "quality",
    "lineage"
   ],
   "properties": {
    "frame_id": {
     "type": "string"
    },
    "t_mono_s": {
     "type": "number"
    },
    "t_utc": {
     "type": "string",
     "format": "date-time"
    },
    "video_pts_s": {
     "type": "number"
    },
    "camera_id": {
     "type": "string"
    },
    "image": {
     "type": "object",
     "required": [
      "sha256",
      "width",
      "height"
     ],
     "properties": {
      "sha256": {
       "type": "string",
       "pattern": "^[0-9a-f]{64}$"
      },
      "width": {
       "type": "integer"
      },
      "height": {
       "type": "integer"
      },
      "format": {
       "type": "string"
      },
      "storage_ref": {
       "type": "string"
      }
     }
    },
    "pose": {
     "type": "object",
     "required": [
      "convention",
      "tracking",
      "session_origin_epoch"
     ],
     "properties": {
      "convention": {
       "enum": [
        "arkit_y_up_rh",
        "arcore_y_up_rh",
        "opencv_z_forward",
        "unknown"
       ]
      },
      "camera_to_session": {
       "type": "array",
       "items": {
        "type": "number"
       },
       "minItems": 16,
       "maxItems": 16
      },
      "source": {
       "enum": [
        "device_tracking",
        "estimated_offline"
       ]
      },
      "tracking": {
       "type": "object",
       "required": [
        "state"
       ],
       "properties": {
        "state": {
         "enum": [
          "normal",
          "limited",
          "not_available"
         ]
        },
        "reason": {
         "type": "string"
        },
        "quality": {
         "type": "number",
         "minimum": 0,
         "maximum": 1
        }
       }
      },
      "session_origin_epoch": {
       "type": "integer",
       "minimum": 0
      },
      "session_to_map": {
       "oneOf": [
        {
         "type": "null"
        },
        {
         "type": "object",
         "required": [
          "map_revision",
          "transform",
          "quality"
         ],
         "properties": {
          "map_revision": {
           "type": "string"
          },
          "transform": {
           "type": "array",
           "items": {
            "type": "number"
           },
           "minItems": 16,
           "maxItems": 16
          },
          "quality": {
           "type": "number"
          }
         }
        }
       ]
      }
     }
    },
    "position_prior": {
     "type": [
      "object",
      "null"
     ],
     "properties": {
      "source": {
       "enum": [
        "gnss",
        "fused",
        "provider_vps"
       ]
      },
      "lat": {
       "type": "number"
      },
      "lon": {
       "type": "number"
      },
      "alt_m": {
       "type": "number"
      },
      "alt_ref": {
       "enum": [
        "ellipsoid_wgs84",
        "navd88",
        "msl_unknown"
       ]
      },
      "h_acc_m": {
       "type": "number"
      },
      "v_acc_m": {
       "type": "number"
      }
     }
    },
    "depth": {
     "type": [
      "object",
      "null"
     ],
     "required": [
      "source",
      "measured",
      "units",
      "representation",
      "aligned_to_camera_id",
      "confidence",
      "sha256"
     ],
     "properties": {
      "source": {
       "enum": [
        "sensor_lidar",
        "sensor_tof",
        "estimated_depth_from_motion",
        "estimated_learned",
        "provider_geospatial"
       ]
      },
      "measured": {
       "type": "boolean"
      },
      "units": {
       "const": "m"
      },
      "representation": {
       "enum": [
        "camera_z",
        "ray_distance"
       ]
      },
      "width": {
       "type": "integer"
      },
      "height": {
       "type": "integer"
      },
      "aligned_to_camera_id": {
       "type": "string"
      },
      "t_mono_s": {
       "type": "number"
      },
      "invalid_value": {
       "type": "number"
      },
      "confidence": {
       "type": "object",
       "required": [
        "present"
       ]
      },
      "sha256": {
       "type": "string",
       "pattern": "^[0-9a-f]{64}$"
      },
      "model": {
       "type": "object",
       "properties": {
        "name": {
         "type": "string"
        },
        "checkpoint": {
         "type": "string"
        },
        "license": {
         "type": "string"
        }
       }
      }
     }
    },
    "imu": {
     "type": [
      "object",
      "null"
     ],
     "properties": {
      "stream_id": {
       "type": "string"
      }
     }
    },
    "quality": {
     "type": "object",
     "required": [
      "selected_reason"
     ]
    },
    "selected": {
     "type": "boolean"
    },
    "lineage": {
     "type": "object",
     "required": [
      "processing_version"
     ],
     "properties": {
      "sha256": {
       "type": "string",
       "pattern": "^[0-9a-f]{64}$"
      },
      "upload_receipt": {
       "type": [
        "string",
        "null"
       ]
      },
      "processing_version": {
       "type": "string"
      }
     }
    }
   }
  }
 }
}
