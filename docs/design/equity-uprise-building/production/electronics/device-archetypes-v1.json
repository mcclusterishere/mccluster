      "display_surface"
    ],
    "required_expectation_fields": [
      "expected_components",
      "expected_ports",
      "expected_state_behaviors",
      "expected_interactions"
    ],
    "ci_policy": {
      "fail_on_untracked_installed_physical_type": true,
      "fail_on_missing_expectations": true,
      "fail_on_maturity_regression": true,
      "allow_tracked_incomplete_types": true,
      "note": "CI enforces exhaustive truthful coverage now; target completion is promoted type-by-type without falsely declaring placeholder geometry complete."
    }
  }
