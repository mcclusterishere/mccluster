  "coverage_contract": {
    "scope": "Every Step 4B installed physical electronics asset type plus canonical pre-existing device surfaces that participate in the Step 4B physical connection graph.",
    "source_count_authority": "generated/equity-uprise-electronics-step4a-report.json::new_asset_type_counts",
    "connection_authority": "generated/equity-uprise-electronics-connections-v1.json",
    "maturity_order": [
      "placeholder",
      "recognizable",
      "componentized",
      "interactive",
      "lab_complete"
    ],
    "target_maturity": "lab_complete",
    "excluded_nonphysical_asset_types": [
      "logical_service",
      "ssid",
      "vlan"
    ],
    "canonical_surface_source_categories": [
      "interactive_terminal",
      "terminal",
      "display",
      "equipment",
      "instrument",
      "furniture"
    ],
    "canonical_surface_archetypes": [
      "interactive_terminal_surface",
