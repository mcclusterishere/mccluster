+function watch(promise){const seen={state:'pending'};promise.then(value=>{seen.state='resolved';seen.value=value;},error=>{seen.state='rejected';seen.error=error;});return seen;}
+function gate(){let open,fail;const promise=new Promise((resolve,reject)=>{open=resolve;fail=reject;});return {promise,open,fail};}
