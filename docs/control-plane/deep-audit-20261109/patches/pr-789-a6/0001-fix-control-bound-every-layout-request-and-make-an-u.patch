+/* The one bounded request helper Control editors share (js/control-room/bounded-request.js):
+   a deadline over every await, an AbortSignal for the transport, and a generation
+   counter that discards whatever settles late. Deterministic: the clock is injected. */
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import vm from 'node:vm';
+import {readFile} from 'node:fs/promises';
+
