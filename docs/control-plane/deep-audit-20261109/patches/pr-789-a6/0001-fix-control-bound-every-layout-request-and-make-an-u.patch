+ const clock=fakeClock(),window={CR:{},setTimeout:clock.set,clearTimeout:clock.clear,AbortController,...options.window};
+ vm.runInNewContext(await readFile('js/control-room/bounded-request.js','utf8'),{window});
+ return {clock,window,bounded:window.CR.boundedRequest,scope:options.create===false?null:window.CR.boundedRequest.create(options.config)};
+}
+
+test('resolves with the task value, hands the task an AbortSignal and leaves no timer behind',async()=>{
+ const x=await setup();let control,calls=0;
+ const value=await x.scope.run(c=>{calls++;control=c;return Promise.resolve('answer');});
+ assert.equal(value,'answer');assert.equal(calls,1);
+ assert.ok(control.signal instanceof AbortSignal);assert.equal(control.signal.aborted,false);
+ assert.equal(control.ticket,1);assert.equal(x.scope.generation(),1);assert.equal(x.scope.pending(),false);
+ assert.equal(x.clock.pending(),0,'the deadline timer is cleared when the request settles');
+});
+
+test('the default deadline is 15 s and ends a request that never answers; the late answer is discarded',async()=>{
+ const x=await setup(),late=gate();let control;
+ assert.equal(x.bounded.DEFAULT_TIMEOUT_MS,15000);
+ const seen=watch(x.scope.run(c=>{control=c;return late.promise;}));
+ x.clock.advance(14999);await flush();assert.equal(seen.state,'pending');assert.equal(control.signal.aborted,false);
+ x.clock.advance(1);await flush();
+ assert.equal(seen.state,'rejected');assert.equal(seen.error.bounded,true);assert.equal(seen.error.code,'timeout');
+ assert.equal(control.signal.aborted,true,'the transport is told to stop');assert.equal(control.current(),false);
+ assert.equal(x.scope.pending(),false);assert.equal(x.clock.pending(),0);
+ late.open('late success');await flush();
+ assert.equal(seen.state,'rejected','a late success never replaces the reported outcome');assert.equal(seen.value,undefined);
+});
+
+test('a scope deadline and a per-request deadline both override the default',async()=>{
+ const x=await setup({config:{timeoutMs:400}});
+ const scoped=watch(x.scope.run(()=>new Promise(()=>{})));
+ x.clock.advance(399);await flush();assert.equal(scoped.state,'pending');
+ x.clock.advance(1);await flush();assert.equal(scoped.error.code,'timeout');
+ const single=watch(x.scope.run(()=>new Promise(()=>{}),{timeoutMs:50}));
+ x.clock.advance(50);await flush();assert.equal(single.error.code,'timeout');
+ for(const bad of [0,-5,NaN,Infinity,'40']){const y=await setup({config:{timeoutMs:bad}}),seen=watch(y.scope.run(()=>new Promise(()=>{})));y.clock.advance(14999);await flush();assert.equal(seen.state,'pending','an unusable deadline falls back to the default, never to no deadline');y.clock.advance(1);await flush();assert.equal(seen.error.code,'timeout');}
+});
+
