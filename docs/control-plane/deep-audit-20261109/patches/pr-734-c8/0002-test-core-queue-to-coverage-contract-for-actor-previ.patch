 .../actor-coverage-queue-contract.test.mjs    | 169 ++++++++++++++++++
 1 file changed, 169 insertions(+)
 create mode 100644 core/test/actor-coverage-queue-contract.test.mjs

diff --git a/core/test/actor-coverage-queue-contract.test.mjs b/core/test/actor-coverage-queue-contract.test.mjs
new file mode 100644
index 00000000..533649f9
--- /dev/null
+++ b/core/test/actor-coverage-queue-contract.test.mjs
@@ -0,0 +1,169 @@
+import test, { after } from 'node:test';
+import assert from 'node:assert/strict';
+import { randomUUID } from 'node:crypto';
+import { planActorCoverage, coverageStatus, DEFAULT_COVERAGE_POLICY } from '../src/actors/coverage.mjs';
+import { buildCompletionEvidence } from '../src/completion-evidence.mjs';
+import { PROMPT_VERSION } from '../src/actors/generate.mjs';
+
+// Queue-to-coverage contract. Planned preview jobs go through the real queue
+// writer (enqueueJob, claimNext, completeJob, failJob), the runner's dependency
+// step and the real preview executor, exactly in runner.mjs order; coverageStatus
+// then reads the rows as stored. Only PostgREST and the local model are stand-ins.
+// The writer reads its address once, at import, so the environment comes first.
+const saved = ['SUPABASE_URL', 'SUPABASE_SECRET_KEY', 'MCCLUSTER_CORE_ID'].map(name => [name, process.env[name]]);
+Object.assign(process.env, { SUPABASE_URL: 'https://queue-coverage.test', SUPABASE_SECRET_KEY: 'sb_secret_test', MCCLUSTER_CORE_ID: 'core:queue-coverage-contract' });
+const { enqueueJob, claimNext, completeJob, failJob, rest } = await import('../src/supabase.mjs');
+const { prepareClaimedDagJob } = await import('../src/objective-dag-store.mjs');
+const { actorCommentPreview } = await import('../src/executors/actor-comment-preview.mjs');
+
+const HOUSE = '123e4567-e89b-42d3-a456-426614174000';
+const [A, B, C, D, E] = [1, 2, 3, 4, 5].map(n => `00000000-0000-4000-8000-${String(n).padStart(12, '0')}`);
+// Synthetic identities used only to exercise the cast contract; not Hitman canon.
+const character = (key, rhythm) => ({ actor_key: key, name: 'Test ' + key, identity_kind: 'fictional_ai', identity_status: 'approved', approval_ref: 'test-only-owner-approval',
+  canon: { version: 'fixture-v1', status: 'verified', approval_ref: 'test-only-canon-approval', sources: [{ ref: 'synthetic-fixture', version: '1', status: 'OWNER_APPROVED' }] },
+  voice: { perspective: 'Practical questions', rhythm, humor: 'Gentle', motivation: 'Understand the detail' }, topics: ['community'], surfaces: ['news', 'song', 'post'] });
+const config = { schema: 'actor-persona/v1', version: 'fixture-only-1', selected_cast: ['test.one', 'test.two'], characters: [character('test.one', 'Short and direct'), character('test.two', 'Warm and patient')] };
+const policy = { ...DEFAULT_COVERAGE_POLICY, enabled: true, surfaces: ['news'] };
+const started = Date.now();
+const article = (id, hoursAgo) => ({ id, title: 'Community listening session promotes neighborhood communication', canonical_url: `https://news.example/${id}`, published_at: new Date(started - hoursAgo * 3_600_000).toISOString() });
+const items = [[A, 6], [B, 5], [C, 4]].map(([id, hoursAgo]) => ({ kind: 'news', ...article(id, hoursAgo) }));
+
+// In-memory stand-in for PostgREST over the tables these calls touch. Rows are
+// stored as the database stores them (a JSON round trip, and the ops_agent_jobs
+// defaults of 20260919053445_operational_ontology_v1.sql); only the filters,
+// ordering and Prefer behaviour the callers use are modelled. B was removed after
+// planning, and every read of C's article answers 503.
+const db = { orgs: [{ id: HOUSE, slug: 'mccluster', enabled: true }], ops_agent_jobs: [], media_news_articles: [article(A, 6), article(C, 4), article(D, 3)],
+  ops_platform_actors: config.characters.map((c, n) => ({ actor_key: c.actor_key, org_id: HOUSE, m_uid: `00000000-0000-4000-9000-00000000000${n}`, enabled: true,
+    persona: { name: c.name, commenting: { config_version: config.version, selected: true, character: c } } })) };
+const written = [];
+const jobDefaults = () => { const now = new Date().toISOString(); return { id: randomUUID(), objective_id: null, target_type: null, target_id: null, status: 'queued', priority: 50,
+  input: {}, output: {}, attempts: 0, max_attempts: 3, run_after: now, locked_at: null, locked_by: null, last_error: null, created_at: now, updated_at: now }; };
+const ISO = /^\d{4}-\d{2}-\d{2}T/;
+function matches(value, condition) {
+  const [op, ...parts] = condition.split('.'), operand = parts.join('.');
+  if (op === 'is' && operand === 'null') return value == null;
+  if (value == null) return false;
+  if (op === 'eq') return String(value) === operand;
+  if (op === 'in') return operand.replace(/^\(|\)$/g, '').split(',').includes(String(value));
+  if ((op === 'lt' || op === 'lte') && ISO.test(value) && ISO.test(operand)) return op === 'lt' ? Date.parse(value) < Date.parse(operand) : Date.parse(value) <= Date.parse(operand);
+  throw new Error(`Unmodelled filter ${condition}`);
+}
+function sorted(rows, order) {
+  if (!order) return rows;
+  const keys = order.split(',').map(k => k.split('.'));
+  return [...rows].sort((a, b) => { for (const [column, dir] of keys) if (a[column] !== b[column]) return (a[column] < b[column] ? -1 : 1) * (dir === 'desc' ? -1 : 1); return 0; });
+}
+async function postgrest(url, init = {}) {
+  const { pathname, searchParams } = new URL(url), table = pathname.replace(/^\/rest\/v1\//, ''), method = init.method || 'GET', rows = db[table];
+  if (!rows) throw new Error(`Unmodelled table ${table}`);
+  if (table === 'media_news_articles' && searchParams.get('id') === `eq.${C}`) return Response.json({ message: 'upstream connect error' }, { status: 503 });
+  const prefer = new Headers(init.headers).get('prefer') || '';
+  const filters = [...searchParams].filter(([key]) => !['select', 'order', 'limit', 'on_conflict'].includes(key));
+  const found = () => rows.filter(row => filters.every(([column, condition]) => matches(row[column], condition)));
+  const columns = searchParams.get('select');
+  const project = row => !columns || columns === '*' ? row : Object.fromEntries(columns.split(',').map(c => { if (!(c in row)) throw new Error(`Unmodelled column ${table}.${c}`); return [c, row[c]]; }));
+  if (method === 'GET') return Response.json(sorted(found(), searchParams.get('order')).slice(0, Number(searchParams.get('limit') || Infinity)).map(project));
+  if (table !== 'ops_agent_jobs') throw new Error(`Unmodelled write to ${table}`);
+  const body = JSON.parse(init.body);
+  for (const row of [].concat(body)) if (row.status) written.push(row.status);
+  if (method === 'PATCH') { const changed = found(); for (const row of changed) Object.assign(row, structuredClone(body)); return prefer.includes('return=minimal') ? new Response(null, { status: 204 }) : Response.json(changed); }
+  if (method !== 'POST') throw new Error(`Unmodelled ${method}`);
+  const inserted = [];
+  for (const row of [].concat(body).map(r => ({ ...jobDefaults(), ...structuredClone(r) }))) {
+    if (rows.some(r => r.id === row.id)) { if (prefer.includes('resolution=ignore-duplicates')) continue; return Response.json({ code: '23505', message: 'duplicate key value violates unique constraint' }, { status: 409 }); }
+    rows.push(row); inserted.push(row);
+  }
+  return Response.json(inserted, { status: 201 });
+}
+const originalFetch = globalThis.fetch;
+globalThis.fetch = postgrest;
+after(() => { globalThis.fetch = originalFetch; for (const [name, value] of saved) if (value === undefined) delete process.env[name]; else process.env[name] = value; });
+
+// Deliberately synthetic local-model replies, never reported as model output: an
+// open question anchored in the headline it was given, then a permissive review.
+const comment = 'A neighborhood listening session? What would make it easier for quieter neighbors to speak?';
+async function chat(request) {
+  const { evidence } = JSON.parse(request.messages[1].content), anchor = { source_id: evidence.sources[0].source_id, quote: evidence.sources[0].text };
+  const claims = [{ text: comment, kind: 'question', source_ids: [anchor.source_id] }];
+  const reply = request.metadata.job_type === 'actor_comment_preview' ? { decision: 'comment', source_item_id: evidence.item.id, comment, evidence: [anchor], claims }
+    : { approved: true, grounded: true, relevant: true, voice_consistent: true, issues: [], reason: 'Synthetic permissive review; not semantic proof.', anchors: [anchor],
+      claim_reviews: claims.map((_, index) => ({ index, supported: true, reason: 'Synthetic permissive verdict' })) };
+  return { model: 'fixture-local-model', implementation: 'fixture', usage: { eval_count: 42 }, message: { content: JSON.stringify(reply) } };
+}
+
+// runner.mjs cycle() and execute() for one claimed job, without its logs, events
+// and owner texts. The executor keeps its production defaults except the model.
+const failures = [];
+async function execute(claimed) {
+  const prepared = await prepareClaimedDagJob(claimed);
+  assert.equal(prepared.action, 'execute');
+  const job = prepared.job, startedAt = new Date().toISOString();
+  try {
+    const output = buildCompletionEvidence(job, await actorCommentPreview(job, { chat }), { startedAt, completedAt: new Date().toISOString() });
+    await completeJob(job, output);
+  } catch (error) { failures.push({ item_id: job.input.item_id, message: error.message }); await failJob(job, error); }
+}
+const runOne = async () => { const claimed = await claimNext(['actor_comment_preview']); if (claimed) await execute(claimed); return claimed; };
+const readJobs = async () => (await rest(`ops_agent_jobs?${new URLSearchParams({ org_id: `eq.${HOUSE}`, job_type: 'eq.actor_comment_preview', select: '*', order: 'created_at.asc' })}`)).body;
+const byItem = rows => Object.fromEntries(coverageStatus(rows).map(view => [view.item_id, view]));
+const queueView = ({ status, preview_outcome, attempts }) => ({ status, preview_outcome, attempts });
+
+test('planned actor previews keep the queue status and their own outcome from the queue writer to coverage (C8)', async t => {
+  const plan = planActorCoverage({ orgId: HOUSE, items, personaConfig: config, policy, load: { pending: 0, daily: 0, per_actor: {} }, now: new Date() });
+  assert.deepEqual(plan.jobs.map(j => j.input.item_id), [A, B, C]);
+  for (const descriptor of [...plan.jobs, ...plan.jobs]) await enqueueJob(descriptor);
+  // The owner's "Preview one item" operation for D, in question-preview mode.
+  await enqueueJob({ orgId: HOUSE, jobType: 'actor_comment_preview', targetType: 'platform_actor', targetId: 'test.one', maxAttempts: 2,
+    input: { kind: 'news', item_id: D, expected_revision: null, prompt_version: PROMPT_VERSION, thin_context_mode: 'question_preview' } });
+  const enqueued = await readJobs();
+  await t.test('every planned item is queued once, with no outcome yet', () => {
+    assert.deepEqual(enqueued.map(row => row.input.item_id), [A, B, C, D]);
+    for (const view of coverageStatus(enqueued)) assert.deepEqual(queueView(view), { status: 'queued', preview_outcome: null, attempts: 0 });
+  });
+
+  const first = await claimNext(['actor_comment_preview']);
+  const claimed = await readJobs();
+  await t.test('a claimed preview is running, with no outcome yet', () => {
+    assert.deepEqual(queueView(byItem(claimed)[first.input.item_id]), { status: 'running', preview_outcome: null, attempts: 1 });
+  });
+  await execute(first);
+  while (await runOne());
+  const finished = await readJobs();
+  await t.test('audit C8 reproduction: every preview the queue finished is done in coverage, with its outcome beside it', () => {
+    const views = byItem(finished);
+    for (const [item, outcome, reason] of [[A, 'withheld', 'thin_context_abstained'], [B, 'withheld', 'source_unavailable'], [D, 'needs_owner_review', 'semantic_review_not_validated']]) {
+      const row = finished.find(r => r.input.item_id === item);
+      assert.equal(row.status, 'done', `the queue finished ${item} (failures: ${JSON.stringify(failures)})`);
+      assert.equal(row.output.status, outcome);
+      assert.ok(Object.values(views[item]).includes(outcome), `coverage loses the outcome ${outcome} of the finished preview ${item}: ${JSON.stringify(queueView(views[item]))}`);
+      assert.deepEqual({ ...queueView(views[item]), reason: views[item].reason, published: views[item].published }, { status: 'done', preview_outcome: outcome, attempts: 1, reason, published: false });
+    }
+    assert.notEqual(views[A].preview_outcome, views[D].preview_outcome, 'a withheld preview and one awaiting owner review stay distinct');
+  });
+  await t.test('a failed attempt with one left is queued again, with no outcome', () => {
+    assert.deepEqual(queueView(byItem(finished)[C]), { status: 'queued', preview_outcome: null, attempts: 1 });
+    assert.deepEqual(failures, [{ item_id: C, message: 'upstream connect error' }]);
+    assert.ok(Date.parse(finished.find(r => r.input.item_id === C).run_after) > Date.now(), 'failJob schedules the retry after a backoff');
+  });
+
+  // The clock stand-in: the backoff failJob scheduled has passed. Only run_after moves.
+  db.ops_agent_jobs.find(row => row.input.item_id === C).run_after = new Date(Date.now() - 1000).toISOString();
+  while (await runOne());
+  const final = await readJobs();
+  await t.test('an exhausted preview is failed, with no outcome', () => {
+    assert.deepEqual(queueView(byItem(final)[C]), { status: 'failed', preview_outcome: null, attempts: 2 });
+    assert.equal(failures.length, 2);
+  });
+  await t.test('the queue writer wrote only its own status words, never completed', () => {
+    assert.deepEqual([...new Set(written)].sort(), ['done', 'failed', 'queued', 'running']);
+  });
+  await t.test('the coverage view feeds the planner: tracked items are not planned again and the exhausted one stays visible', () => {
+    const perActor = {}; for (const row of final) perActor[row.target_id] = (perActor[row.target_id] || 0) + 1;
+    const next = planActorCoverage({ orgId: HOUSE, items: [...items, { kind: 'news', ...article(D, 3) }, { kind: 'news', ...article(E, 2) }], personaConfig: config, policy,
+      load: { pending: 0, daily: final.length, per_actor: perActor }, existing: coverageStatus(final), now: new Date() });
+    assert.deepEqual(next.jobs.map(j => j.input.item_id), [E]);
+    assert.deepEqual(Object.fromEntries(next.outcomes.filter(o => o.status === 'skipped').map(o => [o.item_id, o.reason])),
+      { [A]: 'already_tracked', [B]: 'already_tracked', [C]: 'retry_exhausted', [D]: 'already_tracked' });
+  });
+});
