+process.once('exit',stop);
+for(const signal of ['SIGTERM','SIGINT'])process.once(signal,()=>{stop();process.exit(1);});
+const run=(tool,args)=>execFileSync(join(bin,tool),args,{env,stdio:'pipe',encoding:'utf8'});
