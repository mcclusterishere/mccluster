{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mccluster.org/contracts/character-brief.v1.schema.json",
  "title": "McCluster Character Studio private character brief v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "display_name",
    "handle",
    "story_world",
    "story_country",
    "editorial_mission",
    "voice",
    "desire",
    "fear",
    "contradiction"
  ],
  "properties": {
    "display_name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 120
    },
    "handle": {
      "type": "string",
      "minLength": 3,
      "maxLength": 32,
      "pattern": "^[a-z0-9][a-z0-9._-]{2,31}$"
    },
    "story_world": {
      "type": "string",
      "minLength": 2,
      "maxLength": 120
    },
    "source_ip": {
      "type": "string",
      "maxLength": 120
    },
    "story_country": {
      "type": "string",
      "pattern": "^[A-Za-z]{2}$"
    },
    "identity_kind": {
      "enum": [
        "fictional_character",
        "studio_system_persona"
      ]
    },
    "editorial_mission": {
      "type": "string",
      "minLength": 12,
      "maxLength": 1000
    },
    "voice": {
      "type": "string",
      "minLength": 3,
      "maxLength": 280
    },
    "desire": {
      "type": "string",
      "minLength": 3,
      "maxLength": 280
    },
    "fear": {
      "type": "string",
      "minLength": 3,
      "maxLength": 280
    },
    "contradiction": {
      "type": "string",
      "minLength": 3,
      "maxLength": 280
    },
    "appearance_direction": {
      "type": "string",
      "maxLength": 500
    },
    "content_pillars": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 80
      }
    }
  }
}
