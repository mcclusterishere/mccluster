--- a/scripts/test/carry.test.mjs
+++ b/scripts/test/carry.test.mjs
@@ -515,6 +515,113 @@ test('js/carry.js adopts the device id only with the platform\'s own agreement,
   assert.equal(unagreed.window.localStorage.getItem('mcc_device'), null, 'no agreement on the platform: no device id');
 });
 
+/* ONE DEVICE ACROSS THE MOVE (review of the release branch, 2026-11-24). js/analytics.js runs before js/tabbar.js loads
+   the carry and mints this origin's device id as it starts, so "only if this origin has none" was never true on a page
+   that counts: the carried id was dropped and one listener became two devices. The carry hands the id to analytics,
+   which takes it up only on the page load that minted its own, before that one was given to anything. */
+test('js/carry.js hands the carried device id to js/analytics.js where this origin already has one, only with the agreement', async () => {
+  const carry = { device: 'device-123' };
+  const asked = [];
+  const win = { MCC_ANALYTICS_CONTEXT: { adoptDevice: (id) => { asked.push(id); return true; } } };
+  const page = platformPage({ local: { mcc_device: 'minted-here' }, fetchImpl: exchange(), win });
+  page.frames[0].fireLoad();
+  answerFrom(page.frames[0], page.posts, page.ev, { carry });
+  await page.carry.started;
+  assert.deepEqual(asked, ['device-123'], 'analytics is asked once, with the carried id');
+  assert.equal(page.window.localStorage.getItem('mcc_device'), 'minted-here', 'the carry itself never writes over an id (analytics decides)');
+  const none = [];
+  const unagreed = platformPage({ accepted: false, local: { mcc_device: 'minted-here' }, fetchImpl: exchange(), win: { MCC_ANALYTICS_CONTEXT: { adoptDevice: (id) => { none.push(id); return true; } } } });
+  unagreed.frames[0].fireLoad();
+  answerFrom(unagreed.frames[0], unagreed.posts, unagreed.ev, { carry });
+  await unagreed.carry.started;
+  assert.deepEqual(none, [], 'no agreement on the platform: nothing is handed over');
+  const bad = [];
+  const odd = platformPage({ local: { mcc_device: 'minted-here' }, fetchImpl: exchange(), win: { MCC_ANALYTICS_CONTEXT: { adoptDevice: (id) => { bad.push(id); return true; } } } });
+  odd.frames[0].fireLoad();
+  answerFrom(odd.frames[0], odd.posts, odd.ev, { carry: { device: '<script>' } });
+  await odd.carry.started;
+  assert.deepEqual(bad, [], 'an id that is not an id is handed to nobody');
+});
+
+/* the real first-party sender out of js/analytics.js, as scripts/test/music-measurement.test.mjs stands it up: its
+   privacy gate, its device id, its outbox, MCC_TRACK and MCC_ANALYTICS_CONTEXT, every request recorded */
+function analyticsPage({ local = {}, agreed = true, gpc = false } = {}) {
+  const src = read('js/analytics.js');
+  const cut = (from, to) => { const a = src.indexOf(from), b = src.indexOf(to, a + from.length); assert.ok(a >= 0 && b > a, `could not find ${from}`); return src.slice(a, b); };
+  const code = cut('var MCC_PRIVACY_REQUIRED_VERSION', '/* EVENT_OUTBOX_FACTORY_END */') +
+    cut('window.MCC_TRACK = (function () {', '\n/* ============================================================\n   MCC_MODEL');
+  const localStorage = storage(Object.assign({ mcc_acq: JSON.stringify({ src: 'direct', med: 'none', cmp: '', plug: '', at: '2026-11-24' }) },
+    agreed ? { mcc_privacy_ack: JSON.stringify({ version: '2026-10-19', accepted_at: '2026-11-24T00:00:00Z' }) } : {}, local));
+  const docListeners = {}, sent = [];
+  const document = { referrer: '', cookie: '', visibilityState: 'visible', currentScript: null, addEventListener: (type, fn) => { (docListeners[type] = docListeners[type] || []).push(fn); } };
+  const context = { document, localStorage, sessionStorage: storage(), URL, URLSearchParams, Intl, Uint8Array,
+    navigator: { onLine: true, language: 'en-US', platform: 'test', userAgent: 'test', vendor: '', maxTouchPoints: 0, globalPrivacyControl: gpc },
+    screen: { width: 390, height: 844, availWidth: 390, availHeight: 844 }, innerWidth: 390, innerHeight: 844, devicePixelRatio: 1,
+    matchMedia: () => ({ matches: false }), addEventListener() {},
+    location: { pathname: '/listen.html', search: '', hostname: 'mccluster.org', origin: PLATFORM, href: PLATFORM + '/listen.html' },
+    crypto: { randomUUID: () => 'aaaaaaaa-aaaa-4aaa-8aaa-' + String(sent.length + Math.random()).replace(/\D/g, '').padEnd(12, '0').slice(0, 12) },
+    setTimeout: () => 0, clearTimeout() {}, setInterval: () => 0, console,
+    fetch: async (url, init) => { sent.push({ url: String(url), body: JSON.parse(init.body) }); return { ok: true, clone: () => ({ json: async () => ({ ok: true }) }) }; } };
+  context.window = context;
+  vm.createContext(context);
+  vm.runInContext(code, context, { filename: 'js/analytics.js (the first-party sender)' });
+  return { localStorage, sent, track: (n, p) => context.MCC_TRACK(n, p), context: context.MCC_ANALYTICS_CONTEXT,
+    async flush() { document.visibilityState = 'hidden'; (docListeners.visibilitychange || []).forEach((fn) => fn()); await new Promise((r) => setImmediate(r)); document.visibilityState = 'visible'; } };
+}
+
+test('js/analytics.js takes the carried device id up on the page load that minted its own, before that one was given to anything', async () => {
+  const OLD = 'd41815a4-f27c-444e-ab03-fc4a0ac5b2c6';
+  const first = analyticsPage();
+  const minted = first.localStorage.getItem('mcc_device');
+  assert.ok(minted && minted !== OLD, 'this origin minted its own id as analytics started');
+  first.track('page_view', {});                        // queued, not yet sent: the id has gone nowhere
+  assert.equal(first.context.adoptDevice(OLD), true);
+  assert.equal(first.localStorage.getItem('mcc_device'), OLD, 'kept for the next page');
+  first.track('share', {});
+  await first.flush();
+  assert.ok(first.sent.length >= 1 && first.sent.every((s) => s.body.device_id === OLD), 'every event of this page is filed under the one id');
+  assert.equal(first.context.adoptDevice('e41815a4-f27c-444e-ab03-fc4a0ac5b2c6'), false, 'once only');
+  assert.equal(first.localStorage.getItem('mcc_device'), OLD);
+});
+
+test('js/analytics.js keeps its own device id when it was here before, was already given out, or the visitor has not agreed', async () => {
+  const OLD = 'd41815a4-f27c-444e-ab03-fc4a0ac5b2c6';
+  const returning = analyticsPage({ local: { mcc_device: 'here-before-0001' } });
+  assert.equal(returning.context.adoptDevice(OLD), false, 'an id from an earlier page load is this origin\'s device already');
+  assert.equal(returning.localStorage.getItem('mcc_device'), 'here-before-0001');
+  const sentOne = analyticsPage();
+  const own = sentOne.localStorage.getItem('mcc_device');
+  sentOne.track('page_view', {});
+  await sentOne.flush();
+  assert.equal(sentOne.sent[0].body.device_id, own);
+  assert.equal(sentOne.context.adoptDevice(OLD), false, 'a batch already went out under this id');
+  sentOne.track('share', {});
+  await sentOne.flush();
+  assert.ok(sentOne.sent.every((s) => s.body.device_id === own), 'so the page stays one device');
+  const readOut = analyticsPage();
+  readOut.context.experienceContext();
+  assert.equal(readOut.context.adoptDevice(OLD), false, 'the id was already read by the experience plane');
+  const attributed = analyticsPage();
+  attributed.context.signupAttribution();
+  assert.equal(attributed.context.adoptDevice(OLD), false, 'or by a sign-up\'s attribution');
+  const signal = analyticsPage({ gpc: true });
+  const before = signal.localStorage.getItem('mcc_device');
+  assert.equal(signal.context.adoptDevice(OLD), false, 'a browser that sends a privacy signal is never joined to its old id');
+  assert.equal(signal.localStorage.getItem('mcc_device'), before);
+  const withdrew = analyticsPage();
+  withdrew.localStorage.removeItem('mcc_privacy_ack');
+  assert.equal(withdrew.context.adoptDevice(OLD), false, 'the agreement withdrawn since the page loaded');
+  for (const bad of ['', 'short', '<script>alert(1)</script>', 'x'.repeat(65), null, 123]) assert.equal(analyticsPage().context.adoptDevice(bad), false, `not an id: ${JSON.stringify(bad)}`);
+  /* never agreed: the whole sender, its device id and adoptDevice with it, sits inside the file's one consent gate (the
+     harness above runs the gate's body on its own), so there is no id and nothing to hand one to */
+  const src = read('js/analytics.js');
+  const gate = src.indexOf('\nif (mccPrivacyAcknowledged() && !mccControlPreview()) {'), closes = src.lastIndexOf('\n } else {');
+  for (const inside of ['var DEVICE_KEY = "mcc_device";', 'adoptDevice: function (id) {', 'window.MCC_ANALYTICS_CONTEXT = {']) {
+    const at = src.indexOf(inside);
+    assert.ok(gate > 0 && at > gate && at < closes && src.indexOf(inside, at + 1) === -1, `${inside} is inside the consent gate, once`);
+  }
+});
+
