diff --git a/scripts/e2e/world-source-profile.e2e.mjs b/scripts/e2e/world-source-profile.e2e.mjs
new file mode 100644
index 00000000..b9119c36
--- /dev/null
+++ b/scripts/e2e/world-source-profile.e2e.mjs
@@ -0,0 +1,694 @@
+/* PROJECT DRAWDOWN'S SOURCE PAGE IN THE WORLD, in a browser (docs/control-plane/WORLD-MISSION-SOURCES.md; every decision there a
+   default adopted pending Matthew's confirmation). The page exactly as it ships (mnet.html, js/world-source-profile.js,
+   css/world-source-profile.css), the real globe (Cesium from CESIUM_DIR), and a fake api.mccluster.org and Supabase in memory:
+   no production call. Fourteen open missions are written as the import writes them (tools/build-mission-import.mjs, from
+   data/missions/drawdown/missions.json) across five of this site's areas, some quoting, some citing CC BY, some naming only;
+   three more are drafts, and one open mission has no catalog. The embedded details answer as an object, as PostgREST does.
+   It holds:
+   - inert until a shown row answers: no row, no door anywhere and ?source= says "That page is not available." on the feed's
+     status line; one sources read per page load; an absent table remembered for the session (no second read after a reload);
+   - shown: the door at the foot of a Drawdown mission's dialog (after Join, outside its detail and credit, Join not moved);
+     the door opens the page (the mission closed, its entry replaced, Back leaves to before the mission, focus back on the
+     opener); a landing on ?source= (replaced; × and Escape put the address back); the index, an area, a field, Next area,
+     All areas, a search with its polite line, All with "Show all"; a row opens the mission over the page, Back closes the
+     mission then the page, the door inside it only closes the mission, focus returns to the row; Share copies
+     https://mccluster.org/?source=project-drawdown on mccluster.org and on matthew.mccluster.org;
+   - the house owner, whose session sees drafts, sees exactly the guest's missions and counts; the owner's preview of a draft
+     and a hidden page (and 401, 403, a shown page);
+   - hostile data draws nothing: a name with a denied word, organizations the link did not name, the two existing rows;
+   - a read in flight shows quiet placeholder rows and counts nothing; failures say so: the missions read (Try again), the area
+     map (one list), none open (the credit without counts); a mission opened with ?return= shows no door;
+   - a first visit: the privacy bar inside the page, in view and reachable, nothing recorded, a mission takes the bar and gives
+     it back; at 390x844, 820x1180, 1280x800 and 844x390, night and day: nothing sideways, no picture of any kind, only the
+     World's own icons, no monogram, the door in the UI face at the credit's size, the trust note between the role line and the
+     facts with its buttons first, 4.5:1 text and a 3:1 focus ring, and no request to drawdown.org, zenodo.org or
+     creativecommons.org.
+     CESIUM_DIR=/path/to/Build/Cesium node scripts/e2e/world-source-profile.e2e.mjs [outDir]
+   Needs Playwright (PLAYWRIGHT_DIR if not resolvable). E2E_ONLY=<scope prefix,...> runs some scopes. */
+import { createServer } from 'node:http';
+import { createRequire } from 'node:module';
+import { readFile, mkdir, writeFile } from 'node:fs/promises';
+import { extname, join, normalize } from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { missionRow, detailsRow } from '../../tools/build-mission-import.mjs';
+import { contrast as pixelContrast } from './support/world-gate-harness.mjs';
+
+const ROOT = fileURLToPath(new URL('../../', import.meta.url));
+const OUT = process.argv[2] || join(ROOT, 'e2e-out', 'world-source-profile');
+const ONLY = (process.env.E2E_ONLY || '').split(',').map((s) => s.trim()).filter(Boolean);
+const runs = (scope) => !ONLY.length || ONLY.some((p) => scope.startsWith(p));
+const require = createRequire(import.meta.url);
+let chromium;
+try { ({ chromium } = require('playwright')); }
+catch { ({ chromium } = createRequire(join(process.env.PLAYWRIGHT_DIR || '/opt/node-tools/node_modules', 'x'))('playwright')); }
+
+/* this checkout, as it ships */
+const TYPES = { '.html': 'text/html', '.js': 'text/javascript', '.mjs': 'text/javascript', '.css': 'text/css', '.json': 'application/json', '.png': 'image/png', '.webp': 'image/webp', '.svg': 'image/svg+xml', '.jpg': 'image/jpeg', '.woff2': 'font/woff2' };
+async function fileFor(pathname) {
+  const path = normalize(decodeURIComponent(pathname)).replace(/^([.][.][/\\])+/, '');
+  return { body: await readFile(join(ROOT, path === '/' ? 'mnet.html' : path)), type: TYPES[extname(path === '/' ? 'mnet.html' : path)] || 'application/octet-stream' };
+}
+const server = createServer(async (req, res) => {
+  try { const f = await fileFor(new URL(req.url, 'http://x').pathname); res.writeHead(200, { 'content-type': f.type }); res.end(f.body); }
+  catch { res.writeHead(404); res.end('not found'); }
+});
+await new Promise((r) => server.listen(0, '127.0.0.1', r));
+const BASE = `http://127.0.0.1:${server.address().port}`;
+const HOSTS = { local: BASE, company: 'https://mccluster.org', matthew: 'https://matthew.mccluster.org' };
+
+/* ---------- the fixture world ---------- */
+const ago = (days) => new Date(Date.now() - days * 864e5).toISOString();
+const CATALOG = JSON.parse(await readFile(join(ROOT, 'data/missions/drawdown/missions.json'), 'utf8')).missions;
+const OPEN_SLUGS = [
+  'drawdown-deploy-alternative-refrigerants', 'drawdown-improve-refrigerant-management', 'drawdown-use-heat-pumps', 'drawdown-use-smart-programmable-thermostats',
+  'drawdown-deploy-alternative-insulation-materials', 'drawdown-deploy-building-automation-systems', 'drawdown-improve-district-heating-buildings', 'drawdown-improve-windows-glass',
+  'drawdown-enhance-public-transit', 'drawdown-reduce-airplane-contrails', 'drawdown-use-nitrous-oxide-removal', 'drawdown-produce-bio-oils',
+  'drawdown-manage-coal-mine-methane', 'drawdown-reduce-food-loss-waste'
+];
+const DRAFT_SLUGS = ['drawdown-improve-diets', 'drawdown-protect-forests', 'drawdown-deploy-agrivoltaics'];
+const bySlug = (slug) => { const m = CATALOG.find((x) => x.slug === slug); if (!m) throw new Error(`fixture slug ${slug} is not in the catalog`); return m; };
+const OPEN = OPEN_SLUGS.map((slug, i) => ({ ...missionRow(bySlug(slug)), status: 'open', created_at: ago(1 + i) }));
+const DRAFTS = DRAFT_SLUGS.map((slug, i) => ({ ...missionRow(bySlug(slug)), created_at: ago(30 + i) }));
+const LOOSE = { id: '0e1f0000-0000-4000-8000-000000000001', campaign_id: null, title: 'Give someone a free ride', description: 'Offer a ride to someone who needs one.', domain: 'community', difficulty: 1, base_points: 10, proof_required: true, verification_mode: 'review', skills: ['service'], capacity: null, status: 'open', starts_at: null, ends_at: null, kind: 'civic', created_at: ago(40) };
+const MISSIONS = [...OPEN, ...DRAFTS, LOOSE];
+const DETAILS = [...OPEN_SLUGS, ...DRAFT_SLUGS].map((slug) => detailsRow(bySlug(slug)));
+const AREA_NAMES = [...new Set(OPEN_SLUGS.map((s) => bySlug(s).sector))];
+const COUNTS = { quote: 0, licence: 0, both: 0, nameOnly: 0 };
+for (const d of DETAILS.filter((x) => OPEN.some((m) => m.id === x.mission_id))) {
+  if (d.about_credit) COUNTS.quote++;
+  if (d.license_name) COUNTS.licence++;
+  if (d.about_credit && d.license_name) COUNTS.both++;
