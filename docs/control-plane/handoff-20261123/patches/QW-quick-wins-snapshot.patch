+.mcc-hold__acts{display:grid;grid-template-columns:minmax(0,1fr);gap:8px}
+.mcc-hold .mcc-hold__go,.mcc-hold .mcc-hold__close{box-sizing:border-box;min-height:44px;display:flex;align-items:center;justify-content:center;
+  padding:10px 14px;border-radius:10px;font:700 14px/1.2 var(--ui,system-ui,sans-serif);text-decoration:none;cursor:pointer}
