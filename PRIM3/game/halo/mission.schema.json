{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mccluster.org/schemas/prim3/halo/mission.schema.json",
  "title": "PRIM3 Halo Mission",
  "type": "object",
  "additionalProperties": false,
  "required": ["mission_id", "core_id", "variant", "country", "region", "facility", "learning_objective", "fictional"],
  "properties": {
    "mission_id": {"type": "string", "pattern": "^(INTRO-[0-9]{2}|CORE-[0-9]{2}-[ABC])$"},
    "core_id": {"type": ["string", "null"]},
    "variant": {"enum": ["INTRO", "A", "B", "C"]},
    "country": {"type": "string", "minLength": 2},
    "region": {"type": "string", "minLength": 2},
    "facility": {"type": "string", "minLength": 2},
    "learning_objective": {"type": "string", "minLength": 1},
    "fictional": {"const": true},
    "primary_characters": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "support_characters": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "mission_type": {"type": "string"},
    "environment_tags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "briefing": {"type": "string"},
    "success_conditions": {"type": "array", "items": {"type": "string"}},
    "failure_conditions": {"type": "array", "items": {"type": "string"}},
    "unlock_dependencies": {"type": "array", "items": {"type": "string"}},
    "canon_refs": {"type": "array", "items": {"type": "string"}},
    "context_profile_ref": {"type": "string", "minLength": 1},
    "technology_context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "local_systems": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "attack_surface_fit": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "constraints": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "anti_misconceptions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "cultural_learning": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "implicit_domains": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "environmental_cues": {"type": "array", "items": {"type": "string"}},
        "avoid": {"type": "array", "items": {"type": "string"}}
      }
    },
    "placement_rationale": {"type": "string"},
    "source_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  }
}
