{
  "schema_version": 1,
  "status": "canonical",
  "principle": "Products are workloads. McCluster is the platform.",
  "planes": {
    "supabase": {
      "role": "durable_truth",
      "authority": ["identity", "organizations", "objectives", "jobs", "communications", "media", "compute", "learning", "product_state", "audit", "provenance"],
      "forbidden_roles": ["public_edge", "gpu_execution", "source_control"]
    },
    "cloudflare": {
      "role": "public_edge",
      "authority": ["auth_boundary", "routing", "api_normalization", "ingress", "rate_limiting"],
      "forbidden_roles": ["canonical_database", "workflow_engine", "gpu_host"]
    },
    "ovh_core": {
      "role": "execution_intelligence",
      "authority": ["runner", "tool_broker", "local_models", "objective_execution", "capability_resolution", "host_supervision"],
      "forbidden_roles": ["public_system_of_record", "source_control"]
    },
    "github": {
      "role": "source_and_promotion",
      "authority": ["source", "ci", "review", "promotion_refs"],
      "forbidden_roles": ["runtime_state", "secrets_database"]
    },
    "compute_nodes": {
      "role": "specialized_execution",
      "authority": ["bounded_capability_execution"],
      "forbidden_roles": ["supabase_service_role", "canonical_scheduler", "public_control_plane"]
    },
    "products": {
      "role": "workloads",
      "authority": ["product_specific_state_and_interfaces"],
      "forbidden_roles": ["parallel_platform_control_plane"]
    }
  },
  "canonical_paths": {
    "core_runner": "core/src/runner.mjs",
    "tool_broker": "core/src/tool-broker.mjs",
    "capability_catalog": "core/capabilities/catalog.json",
    "worker_entry": "workers/mccluster/src/entry.js",
    "supabase_migrations": "supabase/migrations",
    "production_promotion": ".github/workflows/promote-ovh-production.yml",
    "production_deploy_ref": "deploy/ovh-production"
  },
  "superseded_branches": [
    "db/reconcile-live-fabric-v1",
    "reconcile/autonomy-fabric-stack-v1",
    "reconcile/autonomy-fabric-stack-v1-clean",
    "reconcile/autonomy-fabric-stack-v2"
  ],
  "rules": {
    "single_durable_truth_plane": true,
    "single_core_job_system": "ops_agent_jobs",
    "single_objective_system": "ops_objectives",
    "provider_capabilities_are_semantic": true,
    "products_must_not_create_parallel_control_planes": true,
    "legacy_branches_must_be_rebuilt_from_current_main": true,
    "legacy_branches_must_not_be_merged_directly": true
  }
}
