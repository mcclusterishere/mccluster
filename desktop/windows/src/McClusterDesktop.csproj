<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>McCluster</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <RootNamespace>McClusterDesktop</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <!-- Must match the three-part form of AssemblyFileVersion in Version.cs. check-version.ps1 enforces this. -->
    <Version>0.4.0</Version>
    <Description>EquityNet: the McCluster compute network client for Windows</Description>
    <Product>EquityNet</Product>
    <Company>McCluster Corp</Company>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Deterministic>true</Deterministic>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <PackageReferenceLockFilePath>packages.lock.json</PackageReferenceLockFilePath>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- The source stays inside the C# 5 subset so the in-box .NET Framework compiler
         (build-inbox.ps1) and this SDK project build the same files. -->
    <LangVersion>5</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Management" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Security" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4022.49" />
  </ItemGroup>
</Project>
