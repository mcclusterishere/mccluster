# Mentor outreach pipeline. Copy to .env (git ignored) or put these in /etc/mccluster/core.env on the OVH node.
# Nothing here sends email. The scheduled run only fills a review queue.

# master switch for the Core job and its timer seed
OUTREACH_PIPELINE_ENABLED=false

# search: brave | serper | fixture | none
OUTREACH_SEARCH_PROVIDER=none
OUTREACH_SEARCH_API_KEY=

# letter writer: any OpenAI compatible /v1 endpoint (hosted, or one you already run). Without it, research runs and no letters are written.
OUTREACH_LLM_URL=
OUTREACH_LLM_MODEL=
OUTREACH_LLM_API_KEY=

# optional embeddings for the similarity guard (OpenAI compatible /v1/embeddings)
OUTREACH_EMBED_URL=
OUTREACH_EMBED_MODEL=
OUTREACH_EMBED_API_KEY=

# caps: can be lowered, never raised past 150 a day and 50 per frame
OUTREACH_DAILY_CAP=150
OUTREACH_FRAME_CAP=50
OUTREACH_DRAFTS_PER_FRAME=50

# storage: local (JSON under OUTREACH_DATA_DIR) | supabase (needs SUPABASE_URL and SUPABASE_SECRET_KEY)
OUTREACH_STORE=local
OUTREACH_DATA_DIR=
# hand built campaign files used to seed the similarity history and do not contact lists
OUTREACH_HISTORY_DIR=/workspace/hnw-outreach
# where Core finds this folder if it is not beside core/
OUTREACH_PIPELINE_DIR=

# gated send function only (not used by anything scheduled). Leave false.
OUTREACH_SEND_ENABLED=false
