# Equity Fighter: every value here is a placeholder. Never commit real values.
# Everything is OFF unless the flags below are "true" and the secrets are present.
# Put real values in the host's secret store (wrangler secret put / systemd EnvironmentFile), not in git.

# ---- master switch ----------------------------------------------------------
EQUITY_FIGHTER_ENABLED=false

# ---- the house (who the owner is in McCluster) ------------------------------
# House organization UUID (public.orgs) and the owner's auth user UUID (auth.users / org_members role owner).
MCCLUSTER_ORG_ID=
EQUITY_FIGHTER_OWNER_USER_ID=
# Where approvals are decided (shown in chat replies).
EQUITY_FIGHTER_CONTROL_URL=https://mccluster.org/control.html
# Optional active ops_ai_threads id: conversational answers then come from a durable resident McCluster turn.
EQUITY_FIGHTER_THREAD_ID=

# ---- harness transport (how the dispatch layer is reached) ------------------
# edge (default): https://api.mccluster.org/v1/core/mcp with the owner's Supabase session token.
#   The edge checks house-owner membership and stamps the actor itself. Session tokens expire,
#   so this is best for trials; see docs/control-plane/EQUITY-FIGHTER.md "Hosting".
# core: the gateway runs beside Core on OVH and calls the tool broker with the edge machine credential.
EQUITY_FIGHTER_HARNESS_TRANSPORT=edge
EQUITY_FIGHTER_HARNESS_MCP_URL=https://api.mccluster.org/v1/core/mcp
EQUITY_FIGHTER_OWNER_ACCESS_TOKEN=
# transport=core only (same values Core and workers/mccluster-mcp use):
CORE_BROKER_URL=
CORE_BROKER_TOKEN=
CORE_EDGE_SIGNING_KEY=
EQUITY_FIGHTER_HARNESS_TIMEOUT_MS=60000

# ---- Supabase (ef_* tables; supabase/migrations/20261128094204_equity_fighter_chat_v1.sql) ----
SUPABASE_URL=https://zmnhbrjyhxzhkxmhkexs.supabase.co
SUPABASE_SECRET_KEY=

# ---- owner-only access ------------------------------------------------------
# Either list the owner's platform user ids (comma separated) per platform, or set a pairing
# secret (>= 16 chars) and pair once with: npm run pair-code -- <platform> <user id>, then send
# "/pair <code>" from that account. Strangers never get a reply.
EQUITY_FIGHTER_PAIRING_SECRET=
EQUITY_FIGHTER_SLACK_OWNER_IDS=
EQUITY_FIGHTER_TELEGRAM_OWNER_IDS=
EQUITY_FIGHTER_WHATSAPP_OWNER_IDS=
EQUITY_FIGHTER_DISCORD_OWNER_IDS=

# ---- Slack (phase 2, official Events API) -----------------------------------
# Slack app: bot scopes app_mentions:read, im:history, chat:write; event subscriptions
# message.im and app_mention; Request URL https://<gateway host>/webhooks/slack
EQUITY_FIGHTER_SLACK_ENABLED=false
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# ---- Telegram (phase 2, official Bot API webhook) ---------------------------
# Token from @BotFather. Register: setWebhook url=https://<gateway host>/webhooks/telegram secret_token=<TELEGRAM_WEBHOOK_SECRET>
EQUITY_FIGHTER_TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# ---- WhatsApp (phase 6 per spec; official Business Cloud API only) ----------
# Meta bars general-purpose AI assistants on WhatsApp Business (since Jan 15, 2026). Only enable for
# McCluster Corp customer service, after Meta business verification, and set the acknowledgement below.
EQUITY_FIGHTER_WHATSAPP_ENABLED=false
EQUITY_FIGHTER_WHATSAPP_CUSTOMER_SERVICE_ONLY=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v21.0

# ---- Discord (optional, official interactions endpoint, /ask command) -------
EQUITY_FIGHTER_DISCORD_ENABLED=false
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=

# ---- Node runner ------------------------------------------------------------
EQUITY_FIGHTER_HOST=127.0.0.1
EQUITY_FIGHTER_PORT=4790
EQUITY_FIGHTER_RELAY_INTERVAL_MS=20000
