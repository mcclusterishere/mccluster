{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/qwen3:8b",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1"
      },
      "models": {
        "qwen3:8b": {
          "name": "Qwen3 8B local"
        }
      }
    }
  },
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.pem": "deny",
      "*.key": "deny"
    },
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "lsp": "allow",
    "task": "deny",
    "webfetch": "deny",
    "websearch": "deny",
    "external_directory": "deny",
    "bash": {
      "*": "allow",
      "git push *": "deny",
      "git commit *": "deny",
      "git remote *": "deny",
      "gh *": "deny",
      "ssh *": "deny",
      "scp *": "deny",
      "sftp *": "deny",
      "curl *": "deny",
      "wget *": "deny"
    }
  },
  "agent": {
    "build": {
      "permission": {
        "task": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "external_directory": "deny",
        "bash": {
          "git push *": "deny",
          "git commit *": "deny",
          "git remote *": "deny",
          "gh *": "deny",
          "ssh *": "deny",
          "scp *": "deny",
          "sftp *": "deny",
          "curl *": "deny",
          "wget *": "deny"
        }
      }
    }
  }
}
