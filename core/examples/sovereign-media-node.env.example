# GPU node -> McCluster Core compute gateway. Use the public HTTPS compute route.
MCCLUSTER_COMPUTE_URL=https://compute.mccluster.org
MCCLUSTER_ORG_ID=1c0733be-69b5-4e65-abe7-377b492c296b
MCCLUSTER_NODE_NAME=mccluster-sovereign-media-01
MCCLUSTER_NODE_STATE_DIR=/var/lib/mccluster-node
MCCLUSTER_NODE_MANIFEST=/etc/mccluster-node/capabilities.json
MCCLUSTER_NODE_POLL_MS=5000
MCCLUSTER_NODE_HEARTBEAT_MS=30000
MCCLUSTER_NODE_ENGINE_PROBE_MS=15000
MCCLUSTER_NODE_SHUTDOWN_GRACE_MS=120000

# Bootstrap only. Generate on OVH, enroll the node, then rotate/remove it.
MCCLUSTER_NODE_ENROLL_TOKEN=

# Asset Vault write endpoint. This is an McCluster-owned HTTPS ingress, not a
# provider API. The token belongs only to compute workers and the OVH vault.
MCCLUSTER_ASSET_INGEST_URL=https://assets-ingest.mccluster.org/v1/assets
MCCLUSTER_ASSET_INGEST_TOKEN=

# Sovereignty mode: local/open inference only. Executors should fail rather
# than calling a hosted model API when this is required.
MCCLUSTER_SOVEREIGN_MEDIA=required

# Model/cache locations on the GPU machine. These may live on persistent block
# storage even when the GPU VM itself is disposable.
MCCLUSTER_MODEL_ROOT=/opt/mccluster-models
MCCLUSTER_OUTPUT_ROOT=/var/lib/mccluster-node/outputs
HF_HOME=/opt/mccluster-models/huggingface
TRANSFORMERS_CACHE=/opt/mccluster-models/huggingface

# Pin actual revisions/checksums during deployment; do not use floating latest
# in a production proof-of-work record.
MCCLUSTER_FLUX_REVISION=
MCCLUSTER_MINIMAX_H3_REVISION=
MCCLUSTER_STABLE_AUDIO_REVISION=
MCCLUSTER_HUNYUAN3D_REVISION=
