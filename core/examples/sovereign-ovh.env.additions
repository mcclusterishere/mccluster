# Add these to /etc/mccluster/core.env on OVH after generating secrets locally.
# Do not commit real secret values.

MCCLUSTER_SOVEREIGN_MEDIA=required

# McCluster-owned durable asset vault.
MCCLUSTER_ASSET_ROOT=/var/lib/mccluster-assets
MCCLUSTER_ASSET_HOST=127.0.0.1
MCCLUSTER_ASSET_PORT=4810
MCCLUSTER_ASSET_PUBLIC_BASE=https://assets.mccluster.org

# Authenticated upload service for GPU workers. Publish only through TLS and
# protect every write with a long random bearer token.
MCCLUSTER_ASSET_INGRESS_HOST=127.0.0.1
MCCLUSTER_ASSET_INGRESS_PORT=4811
MCCLUSTER_ASSET_INGEST_TOKEN=
MCCLUSTER_ASSET_MAX_BYTES=8589934592

# Optional override for runtime proof checks.
# MCCLUSTER_SOVEREIGN_AUDIT_CAPABILITIES=["image.generate","video.generate","audio.generate","model3d.generate","world.generate","deploy.preview"]
