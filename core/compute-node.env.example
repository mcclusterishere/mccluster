# Public HTTPS endpoint routed to the loopback Core compute gateway.
MCCLUSTER_COMPUTE_URL=https://compute.mccluster.org
MCCLUSTER_ORG_ID=
MCCLUSTER_NODE_NAME=gpu-node-1

# Bootstrap-only enrollment secret. Remove it from node.env after the node
# identity has been accepted by Core. Never place Supabase/Core secrets here.
MCCLUSTER_NODE_ENROLL_TOKEN=

MCCLUSTER_NODE_STATE_DIR=/var/lib/mccluster-node
MCCLUSTER_NODE_MANIFEST=/etc/mccluster-node/capabilities.json

# Runtime cadence. The agent adds bounded jitter/backoff after failures.
MCCLUSTER_NODE_POLL_MS=5000
MCCLUSTER_NODE_HEARTBEAT_MS=30000
MCCLUSTER_NODE_ENGINE_PROBE_MS=15000
MCCLUSTER_NODE_SHUTDOWN_GRACE_MS=30000
