# Public HTTPS endpoint routed to the loopback Core compute gateway.
MCCLUSTER_COMPUTE_URL=https://compute.mccluster.org
MCCLUSTER_ORG_ID=
MCCLUSTER_NODE_NAME=gpu-node-1

# Bootstrap-only enrollment secret. Remove it from node.env after the node
# identity has been accepted by Core. Never place Supabase/Core secrets here.
MCCLUSTER_NODE_ENROLL_TOKEN=
# One-shot bootstrap (the Windows installer uses it): enrol, or confirm the
# existing identity, log compute_node_enroll_only_done and exit 0 (exit 2 when
# the token is missing and no identity exists). The token never stays behind.
# MCCLUSTER_NODE_ENROLL_ONLY=1

# State and manifest. These are the POSIX defaults; on Windows the agent
# defaults to %ProgramData%\mccluster-node and
# %ProgramData%\mccluster-node\capabilities.json (no user name in the path),
# so both lines may be left out there.
MCCLUSTER_NODE_STATE_DIR=/var/lib/mccluster-node
MCCLUSTER_NODE_MANIFEST=/etc/mccluster-node/capabilities.json
# Windows: both default to %ProgramData%\mccluster-node and capabilities.json inside it;
# core\windows\mccluster-node.ps1 -Install writes them (docs/control-plane/WINDOWS-NODE.md).
# A GPU laptop polls at 1000 ms (the agent's floor, the Tier-1 preference lever) while the
# OVH node keeps 5000: first poller wins the claim.

# Runtime cadence. The agent adds bounded jitter/backoff after failures.
# The scheduler is first-poller-wins: a GPU laptop polls at 1000 (the floor;
# 1000-1500 is the range) so it reaches the claim before this CPU node's 5000.
MCCLUSTER_NODE_POLL_MS=5000
MCCLUSTER_NODE_HEARTBEAT_MS=30000
MCCLUSTER_NODE_ENGINE_PROBE_MS=15000
MCCLUSTER_NODE_REQUEST_TIMEOUT_MS=10000
MCCLUSTER_NODE_SHUTDOWN_GRACE_MS=30000

# Yield rule (0 = off). When > 0 and the gateway's heartbeat reply says another
# live gpu-verified node exists, a node that is not itself gpu-verified asks the
# claim to skip tasks younger than this many milliseconds (clamped to 300 s).
# Needs the pending compute_claim_task_yield_v3 SQL; harmless before it.
MCCLUSTER_NODE_YIELD_TO_GPU_MS=0
# How long one positive engine observation (a model loaded with VRAM, read from
# the executor's /health gpu_evidence) keeps hardware_mode at gpu-verified.
MCCLUSTER_NODE_GPU_EVIDENCE_TTL_MS=86400000
# Full hardware discovery spawns processes (on Windows powershell.exe, reg.exe
# and the nvidia-smi attempts, 5 s timeout each); the agent repeats it this
# often (floor 60000) and the 15 s engine probe reuses the cached snapshot.
MCCLUSTER_NODE_HARDWARE_REFRESH_MS=600000

# ---- Images and vision (Core side; none of these is a secret) ----
# Any ai.chat turn that carries an image runs only on a node advertising one of
# these implementations (tried in order); none live means
# LOCAL_AI_NO_VISION_NODE, never a text model.
# MCCLUSTER_LOCAL_AI_VISION_IMPLEMENTATIONS=qwen3-vl.8b.local,qwen3-vl.4b.local
# A vision model on this box's own Ollama adapter; unset on OVH, so an image
# turn never runs on the CPU box.
# MCCLUSTER_OLLAMA_VISION_MODEL=
# Adapter: the exact set of models that take images (default: every allowlisted
# qwen3-vl:* or gemma4:* model). Images in front of any other model are refused
# with AI_CHAT_IMAGE_MODEL_NOT_VISION.
# MCCLUSTER_OLLAMA_VISION_MODELS=
# Context window for a browser or image turn in the resident loop (default 8192).
# MCCLUSTER_BROWSER_TURN_NUM_CTX=8192

# ---- Browser executor (node side; core/src/compute/browser-executor.mjs) ----
# Loopback only, port 4791 by default; the manifest entry browser.act/chromium.local
# points at http://127.0.0.1:4791/execute with health_url /ready.
# MCCLUSTER_BROWSER_EXECUTOR_PORT=4791
# The browser's own persistent profile (default <state dir>/browser-profile) and
# the allowlist file beside the manifest (default <manifest dir>/browser-policy.json,
# {"schema":"mccluster-browser-policy/1","allowed_hosts":[],"allow_subdomains":false};
# an empty list refuses every open).
# MCCLUSTER_BROWSER_PROFILE_DIR=
# MCCLUSTER_BROWSER_POLICY=
# Headed Chromium (MCCLUSTER_BROWSER_HEADED=1) is how the owner signs the profile
# into sites by hand; the scheduled task runs headless.
# MCCLUSTER_BROWSER_HEADED=0
# Per-task caps: steps (max 25), wall time (5000..600000 ms), output bytes.
# MCCLUSTER_BROWSER_MAX_STEPS=25
# MCCLUSTER_BROWSER_MAX_MS=120000
# MCCLUSTER_BROWSER_MAX_OUTPUT_BYTES=1000000
# Where the node's own Playwright lives (the Windows doctor installs
# playwright@1.63.0 under <state dir>\browser); the Core package never depends on it.
# MCCLUSTER_BROWSER_PLAYWRIGHT_DIR=
# PLAYWRIGHT_BROWSERS_PATH=
# Container/CI only: Chromium's sandbox needs user namespaces.
# MCCLUSTER_BROWSER_NO_SANDBOX=0
# Test only: the policy resolver answers a documentation-range address for this
# one name and the executor's egress proxy delivers a connection to that validated
# address to the loopback fixture (core/test/browser-executor.test.mjs).
# MCCLUSTER_BROWSER_TEST_FIXTURE_HOST=

# ---- The lyric machine on this node (core/src/compute/lyrics-executor.mjs) ----
# Loopback only. The manifest entry lyrics.align/lyrics.machine.local points at
# http://127.0.0.1:4792/execute with /ready. Start it with: npm run compute:lyrics
# MCCLUSTER_LYRICS_EXECUTOR_PORT=4792
# The Python that has torch/torchaudio, faster-whisper and demucs ("python" on Windows):
# LYRICS_PYTHON=
# Storage hosts a master may come from (the task carries a one-hour signed URL, never a key):
# MCCLUSTER_LYRICS_AUDIO_HOSTS=zmnhbrjyhxzhkxmhkexs.supabase.co

