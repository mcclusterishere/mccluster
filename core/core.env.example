# Canonical Supabase control plane. Keep this file root-owned on the VPS.
SUPABASE_URL=https://zmnhbrjyhxzhkxmhkexs.supabase.co
# Preferred modern backend key (sb_secret_...). Keep server-side only.
SUPABASE_SECRET_KEY=
# Legacy fallback only. Do not set both unless intentionally migrating.
# SUPABASE_SERVICE_ROLE_KEY=
MCCLUSTER_ORG_ID=
# Dedicated server-to-server secret shared only with Supabase context-core.
# Raw conversation transcripts stay in ai_context and are fetched by reference at execution time.
MCCLUSTER_CONTEXT_TOKEN=
MCCLUSTER_CONTEXT_TIMEOUT_MS=30000

# Durable runner identity and pacing.
MCCLUSTER_CORE_ID=ovh-core-1
MCCLUSTER_POLL_MS=15000
MCCLUSTER_HEARTBEAT_MS=30000

# Repository/worktree locations.
MCCLUSTER_REPO_ROOT=/srv/mccluster/repos
MCCLUSTER_WORKTREE_ROOT=/srv/mccluster/worktrees
MCCLUSTER_GIT_FETCH=1
MCCLUSTER_CODE_REPOS=mcclusterishere/mccluster
MCCLUSTER_PUSH_BRANCHES=1

# Self-hosted preview runtime. Builds happen in isolated git worktrees, publish
# into Core-owned state, and are served by a loopback-only gateway. The public
# base should be routed to 127.0.0.1:4799 by the current edge transport. No
# Vercel or other deployment-provider credential is required.
MCCLUSTER_PREVIEW_HOST=127.0.0.1
MCCLUSTER_PREVIEW_PORT=4799
MCCLUSTER_PREVIEW_ROOT=/var/lib/mccluster-core/previews
MCCLUSTER_PREVIEW_PUBLIC_BASE=https://preview.mccluster.org/p
MCCLUSTER_PREVIEW_URL_PREFIX=p
MCCLUSTER_PREVIEW_TTL_HOURS=24
MCCLUSTER_PREVIEW_MAX_TTL_HOURS=168
MCCLUSTER_PREVIEW_CLEANUP_INTERVAL_MS=3600000
MCCLUSTER_PREVIEW_TIMEOUT_MS=1200000

# Local model / agent plane.
MCCLUSTER_OLLAMA_URL=http://127.0.0.1:11434
MCCLUSTER_OLLAMA_MODEL=qwen3:8b
MCCLUSTER_OLLAMA_CONTEXT=16384
MCCLUSTER_OPENCODE_BIN=/usr/local/bin/opencode
MCCLUSTER_OPENCODE_ATTACH=http://127.0.0.1:4096
MCCLUSTER_OPENCODE_MODEL=ollama/qwen3:8b
MCCLUSTER_OPENCODE_AGENT=build
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=

# Normalized tool bus. The broker itself always binds to loopback.
CORE_BROKER_HOST=127.0.0.1
CORE_BROKER_PORT=4777
CORE_TOOL_CACHE_TTL_MS=60000
# Shared bearer for callers of /v1/tools, /v1/capabilities and /mcp. The broker
# now fails closed: with neither this nor CORE_EDGE_SIGNING_KEY set it answers
# 503 on every route except /health.
CORE_BROKER_TOKEN=
# Signing key for the Cloudflare Worker -> Core hop, shared with the Worker
# secret of the same name. When set, every brokered request must also carry a
# fresh HMAC signature over its own body, so publishing the broker through a
# tunnel does not make one captured request replayable. Rotate by setting a new
# value here and in `wrangler secret put CORE_EDGE_SIGNING_KEY`.
CORE_EDGE_SIGNING_KEY=
# Accepted clock skew for those signatures, in ms. Default 60000.
CORE_EDGE_CLOCK_SKEW_MS=
# Optional owner/user bearer token used only when an upstream MCP tool requires it.
# Do not give this value to mccluster-agent/OpenCode.
MCCLUSTER_API_BEARER=
# Root-controlled optional raw tool registrations. Prefer HTTPS; loopback HTTP is allowed.
# CORE_MCP_SERVERS_JSON=[{"id":"example","namespace":"example","url":"https://example.com/mcp","protocolVersion":"2026-07-28","bearerEnv":"EXAMPLE_TOKEN"}]
# CORE_HTTP_TOOLS_JSON=[{"name":"example.status","request":{"method":"GET","url":"https://example.com/status"}}]
# Root-controlled capability additions. Provider names belong in bindings, not capability ids.
# CORE_CAPABILITIES_JSON=[{"id":"example.lookup","title":"Example lookup","description":"Provider-independent example","domain":"example","lifecycle":"active","execution":"sync","risk":"read","approval":"none","interfaces":["http","mcp","agent"],"inputSchema":{"type":"object","properties":{}},"outputSchema":{"type":"object"}}]
# CORE_CAPABILITY_BINDINGS_JSON=[{"id":"example.primary","capability":"example.lookup","provider":"example-provider","tool":"example.status","transport":"http","status":"active","priority":100,"features":{},"hosting":"self-hosted","billing":"compute"}]

# Self-hosted compute fabric. Gateway is loopback-only; publish it through a
# TLS reverse tunnel/proxy such as Cloudflare Tunnel rather than opening 4788.
CORE_COMPUTE_HOST=127.0.0.1
CORE_COMPUTE_PORT=4788
CORE_COMPUTE_BODY_LIMIT=2097152
CORE_COMPUTE_CLOCK_SKEW_MS=300000
CORE_COMPUTE_HEARTBEAT_SECONDS=30
CORE_COMPUTE_LEASE_SECONDS=120
# Enrollment is bootstrap-only. Rotate after adding nodes.
CORE_COMPUTE_ENROLL_TOKEN=
# Admin token protects node inventory/capability reads and task submission.
CORE_COMPUTE_ADMIN_TOKEN=

# Morning digest + owner notifications. The owned Android/SIM relay is preferred.
# Twilio remains only as an optional compatibility fallback.
MCCLUSTER_DIGEST_HOURS=12
MCCLUSTER_PHONE=
MCCLUSTER_OWNER_PHONE=
MCCLUSTER_PERSONAL_ALIAS=PRIM3
MCCLUSTER_COMMS_PROFILE=personal
MCCLUSTER_SMS_NOTIFY=true
MCCLUSTER_SMS_REQUIRE_RELAY=1

# PRIM3 Android/SIM relay enrollment + SMS Gateway local-server bridge.
MCCLUSTER_RELAY_ID=
MCCLUSTER_RELAY_TOKEN=
MCCLUSTER_RELAY_PHONE=
MCCLUSTER_SMSGATE_ENDPOINT=http://10.77.0.2:8080
MCCLUSTER_SMSGATE_USERNAME=
MCCLUSTER_SMSGATE_PASSWORD=
MCCLUSTER_SMSGATE_WEBHOOK_TOKEN=
MCCLUSTER_SMSGATE_LISTEN_HOST=10.77.0.1
MCCLUSTER_SMSGATE_LISTEN_PORT=4789
MCCLUSTER_SMSGATE_WEBHOOK_URL=
MCCLUSTER_SMSGATE_POLL_MS=2000

# Optional legacy fallback only.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Owned static previews. Activate only after the gateway/tunnel is verified.
MCCLUSTER_PREVIEW_ENABLED=0
MCCLUSTER_PREVIEW_PUBLIC_BASE=https://preview.mccluster.org/p
MCCLUSTER_PREVIEW_ROOT=/var/lib/mccluster-core/previews
# The gateway has its own optional /etc/mccluster/preview.env, without Core secrets.\n\n# Owned meeting-delegate engine. The engine is expected to run on the same VPS\n# or a private McCluster network. Vexa-compatible is the first implementation,\n# but Core calls only provider-neutral meeting capabilities.\nMCCLUSTER_MEETING_ENGINE_URL=http://127.0.0.1:18056\nMCCLUSTER_MEETING_ENGINE_API_KEY=\n# Encryption key for persisted scheduled meeting targets. Keep on Core only.\n# Use a long random value; changing it invalidates still-queued meeting targets.\nMCCLUSTER_MEETING_TARGET_KEY=\nMCCLUSTER_MEETING_PRINCIPAL_NAME=Matthew McCluster\n# Interactive chat/speech remains fail-closed until our deployed engine build\n# passes a live validation. Capture/transcript can run with this left at 0.\nMCCLUSTER_MEETING_INTERACTIVE=0\nMCCLUSTER_MEETING_TIMEOUT_MS=45000\n