# Canonical Supabase control plane. Keep this file root-owned on the VPS.
SUPABASE_URL=https://zmnhbrjyhxzhkxmhkexs.supabase.co
# Preferred modern backend key (sb_secret_...). Keep server-side only.
SUPABASE_SECRET_KEY=
# Legacy fallback only. Do not set both unless intentionally migrating.
# SUPABASE_SERVICE_ROLE_KEY=
MCCLUSTER_ORG_ID=

# Durable runner identity and pacing.
MCCLUSTER_CORE_ID=ovh-core-1
MCCLUSTER_POLL_MS=15000
MCCLUSTER_HEARTBEAT_MS=30000

# Repository/worktree locations.
MCCLUSTER_REPO_ROOT=/srv/mccluster/repos
MCCLUSTER_WORKTREE_ROOT=/srv/mccluster/worktrees
MCCLUSTER_GIT_FETCH=1
MCCLUSTER_CODE_REPOS=mcclusterishere/mccluster
MCCLUSTER_PUSH_BRANCHES=1

# Local model / agent plane.
MCCLUSTER_OLLAMA_URL=http://127.0.0.1:11434
MCCLUSTER_OLLAMA_MODEL=qwen3:8b
MCCLUSTER_OLLAMA_CONTEXT=16384
MCCLUSTER_OPENCODE_BIN=/usr/local/bin/opencode
MCCLUSTER_OPENCODE_ATTACH=http://127.0.0.1:4096
MCCLUSTER_OPENCODE_MODEL=ollama/qwen3:8b
MCCLUSTER_OPENCODE_AGENT=build
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=

# Normalized tool bus. The broker itself always binds to loopback.
CORE_BROKER_HOST=127.0.0.1
CORE_BROKER_PORT=4777
CORE_TOOL_CACHE_TTL_MS=60000
# Optional bearer requirement for local callers of /v1/tools, /v1/capabilities and /mcp.
CORE_BROKER_TOKEN=
# Optional owner/user bearer token used only when an upstream MCP tool requires it.
# Do not give this value to mccluster-agent/OpenCode.
MCCLUSTER_API_BEARER=
# Root-controlled optional raw tool registrations. Prefer HTTPS; loopback HTTP is allowed.
# CORE_MCP_SERVERS_JSON=[{"id":"example","namespace":"example","url":"https://example.com/mcp","protocolVersion":"2026-07-28","bearerEnv":"EXAMPLE_TOKEN"}]
# CORE_HTTP_TOOLS_JSON=[{"name":"example.status","request":{"method":"GET","url":"https://example.com/status"}}]
# Root-controlled capability additions. Provider names belong in bindings, not capability ids.
# CORE_CAPABILITIES_JSON=[{"id":"example.lookup","title":"Example lookup","description":"Provider-independent example","domain":"example","lifecycle":"active","execution":"sync","risk":"read","approval":"none","interfaces":["http","mcp","agent"],"inputSchema":{"type":"object","properties":{}},"outputSchema":{"type":"object"}}]
# CORE_CAPABILITY_BINDINGS_JSON=[{"id":"example.primary","capability":"example.lookup","provider":"example-provider","tool":"example.status","transport":"http","status":"active","priority":100,"features":{},"hosting":"self-hosted","billing":"compute"}]

# Self-hosted compute fabric. Gateway is loopback-only; publish it through a
# TLS reverse tunnel/proxy such as Cloudflare Tunnel rather than opening 4788.
CORE_COMPUTE_HOST=127.0.0.1
CORE_COMPUTE_PORT=4788
CORE_COMPUTE_BODY_LIMIT=2097152
CORE_COMPUTE_CLOCK_SKEW_MS=300000
CORE_COMPUTE_HEARTBEAT_SECONDS=30
CORE_COMPUTE_LEASE_SECONDS=120
# Enrollment is bootstrap-only. Rotate after adding nodes.
CORE_COMPUTE_ENROLL_TOKEN=
# Admin token protects node inventory/capability reads and task submission.
CORE_COMPUTE_ADMIN_TOKEN=

# Morning digest. Twilio is optional; without it the digest is still recorded
# in ops_signals and journald.
MCCLUSTER_DIGEST_HOURS=12
MCCLUSTER_PHONE=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=