  "frame": {
    "id": "mccluster-city.bridgeport-equirect.v1",
    "module": "js/fictional-city/planet/georeference.mjs",
    "axes": "metres; +X east, +Y up, +Z south (McCluster City frame)",
    "horizontal": "x = (lon + 73.1903) * 111320 * cos(41.1798 deg); z = -(lat - 41.1798) * 111320 - 220",
    "geodeticDatum": "NAD83(2011) treated as WGS84 for placement (~1-1.5 m offset in Connecticut)",
    "vertical": "building and terrain Y values are NAVD88 orthometric metres as published; see authoredOverlay.verticalProposal for the proposed city-Y offset (not applied)",
    "floatingOrigin": "createFloatingOrigin(): render origin follows the player in 128 m steps past 512 m; world positions stay double precision",
    "enuCheck": "createEnuFrame({ lon: -73.1903, lat: 41.1798 }) is the measured reference; the equirect frame reads ~0.25 % long north-south (tested bound 0.35 %)"
  },
  "scaleContracts": {
    "city": "1 unit = 1 metre, Y-up",
    "hqModel": "metres, Z-up GLBs; HQ display cell 12 ft = 3.6576 m (the HQ tactical level module in js/prim3-tactics/levels/, WORLD_M)",
    "tactics": "3.54 m rule tile (js/prim3-tactics/scale.mjs TILE_M)",
    "rule": "distinct contracts; never resize the HQ or the tactics grid to match each other or the region"
  },
