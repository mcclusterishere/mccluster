[Unit]
Description=McCluster Core mentor outreach research seed (off unless OUTREACH_PIPELINE_ENABLED=true; fills a review queue, never sends)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=mccluster-core
Group=mccluster-core
SupplementaryGroups=mccluster-work
WorkingDirectory=/opt/mccluster/core
Environment=HOME=/var/lib/mccluster-core
EnvironmentFile=/etc/mccluster/core.env
ExecStart=/usr/bin/node /opt/mccluster/core/src/seed-mentor-outreach.mjs
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictNamespaces=true
SystemCallArchitectures=native
ReadWritePaths=/var/lib/mccluster-core
MemoryMax=256M
CPUQuota=50%
TasksMax=32
