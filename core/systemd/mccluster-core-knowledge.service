[Unit]
Description=McCluster Core daily knowledge consolidation
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
TimeoutStartSec=120
User=mccluster-core
Group=mccluster-core
SupplementaryGroups=mccluster-work
WorkingDirectory=/opt/mccluster/core
Environment=HOME=/var/lib/mccluster-core
EnvironmentFile=/etc/mccluster/core.env
ExecStart=/usr/bin/node /opt/mccluster/core/src/consolidate-knowledge-cli.mjs
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictNamespaces=true
SystemCallArchitectures=native
ReadWritePaths=/var/lib/mccluster-core
MemoryMax=256M
CPUQuota=50%
TasksMax=32
