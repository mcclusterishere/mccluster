    {
      "scenario_id": "EU-CISA-ITOT-039-V1",
      "source_lab_id": "IT-LAB-039",
      "title": "Cross-System Building Incident Response",
      "federal_training_ids": [
        "CISA-ICS-300",
        "CISA-ICS-301"
      ],
      "mode": "SIMULATION",
      "execution_target": "SANDBOX",
      "live_control_allowed": false,
      "learner_brief": "The simulated building has normal-power loss, a degraded core link, and a BAS alarm. Separate primary from secondary effects and restore the sandbox in a safe dependency-aware order.",
      "objectives": [
        {
          "objective_id": "OBJ-039-ASSESS",
          "description": "Inspect the affected building, network, and BAS domains.",
          "required_action_ids": [
            "039-inspect-building",
            "039-inspect-core",
            "039-inspect-bas",
            "039-submit-causality"
          ]
        },
        {
          "objective_id": "OBJ-039-RESTORE",
          "description": "Restore simulated power, network, then BAS state in dependency order.",
          "required_action_ids": [
            "039-stabilize-power",
            "039-restore-core",
            "039-clear-bas-alarm"
          ]
        },
        {
          "objective_id": "OBJ-039-VALIDATE",
          "description": "Validate the whole-building sandbox after restoration.",
          "required_action_ids": [
            "039-validate-building"
          ]
        }
      ],
      "actions": [
        {
          "action_id": "039-inspect-building",
          "action_type": "inspect",
          "target_selector": "whole_building",
          "requires_action_ids": [],
          "observation": {
            "simulated_fault_domains": [
              "normal_power",
              "core_network",
              "bas"
            ]
          },
          "live_control_allowed": false
        },
        {
          "action_id": "039-inspect-core",
          "action_type": "inspect",
          "target_selector": "collapsed_core_switch",
          "requires_action_ids": [
            "039-inspect-building"
          ],
          "observation": {
            "simulated_signal": "Core connectivity is degraded, not fully unavailable."
          },
          "live_control_allowed": false
        },
        {
          "action_id": "039-inspect-bas",
          "action_type": "inspect",
          "target_selector": "bas_controller",
          "requires_action_ids": [
            "039-inspect-building"
          ],
          "observation": {
            "simulated_signal": "BAS alarm is present during the cross-system incident."
          },
          "live_control_allowed": false
        },
        {
          "action_id": "039-submit-causality",
          "action_type": "decision",
          "target_selector": "whole_building",
          "requires_action_ids": [
            "039-inspect-core",
            "039-inspect-bas"
          ],
          "expected_input": {
            "primary_fault": "normal_power_loss",
            "secondary_effects": [
              "core_link_degraded",
              "bas_alarm"
            ]
          },
          "observation": {
            "accepted_causality": "Treat normal power as the primary restoration dependency for this training scenario."
          },
          "live_control_allowed": false
        },
        {
          "action_id": "039-stabilize-power",
          "action_type": "mitigate",
          "target_selector": "whole_building",
          "requires_action_ids": [
            "039-submit-causality"
          ],
          "resolve_fault_ids": [
            "normal_power_loss"
          ],
          "observation": {
            "simulated_change": "Normal-power fault cleared in sandbox; remaining faults preserved for diagnosis."
          },
          "live_control_allowed": false
        },
        {
          "action_id": "039-restore-core",
          "action_type": "mitigate",
          "target_selector": "collapsed_core_switch",
          "requires_action_ids": [
            "039-stabilize-power"
          ],
          "resolve_fault_ids": [
            "core_link_degraded"
          ],
          "observation": {
            "simulated_change": "Core-link degradation cleared after the power dependency was addressed."
          },
          "live_control_allowed": false
        },
        {
          "action_id": "039-clear-bas-alarm",
          "action_type": "mitigate",
          "target_selector": "bas_controller",
          "requires_action_ids": [
            "039-restore-core"
          ],
          "resolve_fault_ids": [
            "bas_alarm"
          ],
          "observation": {
            "simulated_change": "BAS alarm cleared after upstream restoration checks."
          },
          "live_control_allowed": false
        },
        {
          "action_id": "039-validate-building",
          "action_type": "validate",
          "target_selector": "whole_building",
          "requires_action_ids": [
            "039-clear-bas-alarm"
          ],
          "requires_faults_absent": [
            "normal_power_loss",
            "core_link_degraded",
            "bas_alarm"
          ],
          "observation": {
            "validation": "Whole-building sandbox has returned to the modeled baseline."
          },
          "live_control_allowed": false
        }
      ],
