    {
      "scenario_id": "EU-CISA-ITOT-029-V1",
      "source_lab_id": "IT-LAB-029",
      "title": "IT/OT Firewall Segmentation Incident",
      "federal_training_ids": [
        "CISA-ICS-300",
        "CISA-ICS-401",
        "CISA-ICS-301"
      ],
      "mode": "SIMULATION",
      "execution_target": "SANDBOX",
      "live_control_allowed": false,
      "learner_brief": "The simulated BAS-OT segment is exposed by an overpermissive policy. Diagnose the condition, reduce lateral access, preserve required BAS traffic, and validate the sandbox posture.",
      "objectives": [
        {
          "objective_id": "OBJ-029-DIAGNOSE",
          "description": "Diagnose the simulated IT/OT segmentation exposure.",
          "required_action_ids": [
            "029-inspect-ot-vlan",
            "029-inspect-firewall",
            "029-submit-risk"
          ]
        },
        {
          "objective_id": "OBJ-029-MITIGATE",
          "description": "Apply a simulation-only least-privilege correction.",
          "required_action_ids": [
            "029-apply-least-privilege"
          ]
        },
        {
          "objective_id": "OBJ-029-VALIDATE",
          "description": "Validate the BAS-OT segment after mitigation.",
          "required_action_ids": [
            "029-validate-posture"
          ]
        }
      ],
      "actions": [
        {
          "action_id": "029-inspect-ot-vlan",
          "action_type": "inspect",
          "target_selector": "LOGIC-VLAN-BAS-OT",
          "requires_action_ids": [],
          "observation": {
            "simulated_signal": "BAS-OT security state is at_risk while service availability remains present."
          },
          "live_control_allowed": false
        },
        {
          "action_id": "029-inspect-firewall",
          "action_type": "inspect",
          "target_selector": "firewall",
          "requires_action_ids": [],
          "observation": {
            "simulated_signal": "Firewall state shows an overpermissive-rule condition rather than a hardware outage."
          },
          "live_control_allowed": false
        },
        {
          "action_id": "029-submit-risk",
          "action_type": "decision",
          "target_selector": "LOGIC-VLAN-BAS-OT",
          "requires_action_ids": [
            "029-inspect-ot-vlan",
            "029-inspect-firewall"
          ],
          "expected_input": {
            "finding": "overpermissive_rule"
          },
          "observation": {
            "accepted_finding": "The exposure is policy scope, not loss of BAS service."
          },
          "live_control_allowed": false
        },
        {
          "action_id": "029-apply-least-privilege",
          "action_type": "mitigate",
          "target_selector": "firewall",
          "requires_action_ids": [
            "029-submit-risk"
          ],
          "resolve_fault_ids": [
            "overpermissive_rule"
          ],
          "observation": {
            "simulated_change": "Policy narrowed to required BAS-OT flows in the sandbox only."
          },
          "live_control_allowed": false
        },
        {
          "action_id": "029-validate-posture",
          "action_type": "validate",
          "target_selector": "LOGIC-VLAN-BAS-OT",
          "requires_action_ids": [
            "029-apply-least-privilege"
          ],
          "requires_faults_absent": [
            "overpermissive_rule"
          ],
          "observation": {
            "validation": "BAS-OT security posture returned to baseline with no simulated fault active."
          },
          "live_control_allowed": false
        }
      ],
      "verification_path": [
        {
          "action_id": "029-inspect-ot-vlan",
          "input": {}
        },
        {
          "action_id": "029-inspect-firewall",
          "input": {}
        },
        {
          "action_id": "029-submit-risk",
          "input": {
            "finding": "overpermissive_rule"
          }
        },
        {
          "action_id": "029-apply-least-privilege",
          "input": {}
        },
        {
          "action_id": "029-validate-posture",
          "input": {}
        }
      ]
    },
